@model DentalSync.ViewModels.GlobalAnalyticsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Global Analytics & Reports";
    Layout = null;
    var labels = Model.RevenueByMonth.Select(point => point.Label).Union(Model.PatientGrowth.Select(point => point.Label)).Distinct().OrderBy(label => label).ToList();
    var loginLabels = Model.LoginsByMonth.Select(point => point.Label).Union(Model.FailedLoginsByMonth.Select(point => point.Label)).Distinct().OrderBy(label => label).ToList();
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@await Html.PartialAsync("~/Views/Shared/SuperadminBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="stylesheet" href="~/css/users.css" />
<link rel="stylesheet" href="~/css/reports.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/SuperadminBars/_Sidebar.cshtml")
    <main class="users-page global-analytics-page">
        <div class="users-page-heading">
            <div>
                <h1>Global Analytics &amp; Reports</h1>
                <p>Live platform, clinic, and security metrics from the DentalSync database.</p>
            </div>
        </div>

        <div class="dc-kpi-grid">
            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <span class="dc-kpi-delta dc-delta-up">Active</span>
                </div>
                <div class="dc-kpi-value">@Model.TotalUsers.ToString("N0")</div>
                <div class="dc-kpi-label">Registered Users</div>
            </div>

            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-teal">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l5 5v13a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M14 3v5h5"/><path d="M9 12h6M9 16h6"/></svg>
                    </div>
                    <span class="dc-kpi-delta dc-delta-up">Records</span>
                </div>
                <div class="dc-kpi-value">@Model.TotalPatients.ToString("N0")</div>
                <div class="dc-kpi-label">Patient Records</div>
            </div>

            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-green">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    </div>
                    <span class="dc-kpi-delta dc-delta-up">Booked</span>
                </div>
                <div class="dc-kpi-value">@Model.TotalAppointments.ToString("N0")</div>
                <div class="dc-kpi-label">Appointments</div>
            </div>

            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-amber">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </div>
                    <span class="dc-kpi-delta dc-delta-up">Collected</span>
                </div>
                <div class="dc-kpi-value">₱@Model.TotalRevenue.ToString("N0")</div>
                <div class="dc-kpi-label">Collected Revenue</div>
            </div>

            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    </div>
                    <span class="dc-kpi-delta dc-delta-down">Alerts</span>
                </div>
                <div class="dc-kpi-value">@Model.FailedLogins.ToString("N0")</div>
                <div class="dc-kpi-label">Failed Logins</div>
            </div>

            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-amber">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M12 16h.01"/></svg>
                    </div>
                    <span class="dc-kpi-delta @(Model.LockedAccounts > 0 ? "dc-delta-down" : "dc-delta-flat")">@(Model.LockedAccounts > 0 ? "Review" : "Normal")</span>
                </div>
                <div class="dc-kpi-value">@Model.LockedAccounts.ToString("N0")</div>
                <div class="dc-kpi-label">Locked Accounts</div>
            </div>
        </div>

        <div class="rp-analytics-grid global-analytics-primary">
            <section class="rp-panel"><div class="rp-panel-header"><div><div class="rp-panel-title">Platform Growth</div><div class="rp-panel-sub">Revenue and new patients over the last six months</div></div></div><div class="rp-panel-body"><div class="rp-chart-wrap"><canvas id="growthChart"></canvas></div></div></section>
            <section class="rp-panel"><div class="rp-panel-header"><div><div class="rp-panel-title">User Roles</div><div class="rp-panel-sub">Current registered accounts by role</div></div></div><div class="rp-panel-body"><div class="rp-chart-wrap"><canvas id="rolesChart"></canvas></div></div></section>
        </div>

        <div class="rp-analytics-grid global-analytics-secondary">
            <section class="rp-panel"><div class="rp-panel-header"><div><div class="rp-panel-title">Appointment Volume</div><div class="rp-panel-sub">Appointments created by month</div></div></div><div class="rp-panel-body"><div class="rp-chart-wrap"><canvas id="appointmentsChart"></canvas></div></div></section>
            <section class="rp-panel"><div class="rp-panel-header"><div><div class="rp-panel-title">System Security</div><div class="rp-panel-sub">Successful and failed authentication events</div></div></div><div class="rp-panel-body"><div class="rp-chart-wrap"><canvas id="securityTrendChart"></canvas></div></div></section>
        </div>

        <div class="rp-analytics-grid-3">
            <section class="rp-panel"><div class="rp-panel-header"><div><div class="rp-panel-title">Audit Activity</div><div class="rp-panel-sub">Events grouped by module</div></div></div><div class="rp-panel-body"><div class="rp-chart-wrap"><canvas id="auditChart"></canvas></div></div></section>
            <section class="rp-panel"><div class="rp-panel-header"><div><div class="rp-panel-title">Browser Sessions</div><div class="rp-panel-sub">Recorded audit log user agents</div></div></div><div class="rp-panel-body"><div class="rp-chart-wrap"><canvas id="browserChart"></canvas></div></div></section>
            <section class="rp-panel"><div class="rp-panel-header"><div><div class="rp-panel-title">Account Security</div><div class="rp-panel-sub">Current access status</div></div></div><div class="rp-panel-body"><div class="rp-chart-wrap"><canvas id="accountSecurityChart"></canvas></div></div></section>
        </div>
    </main>
</div>

<script>
    Chart.defaults.font.family = "Inter, -apple-system, sans-serif";
    Chart.defaults.font.size = 11;
    Chart.defaults.color = "#94a3b8";

    const labels = @Html.Raw(JsonSerializer.Serialize(labels, jsonOptions));
    const loginLabels = @Html.Raw(JsonSerializer.Serialize(loginLabels, jsonOptions));
    const revenue = @Html.Raw(JsonSerializer.Serialize(labels.Select(label => Model.RevenueByMonth.FirstOrDefault(point => point.Label == label)?.Value ?? 0m).ToList(), jsonOptions));
    const patients = @Html.Raw(JsonSerializer.Serialize(labels.Select(label => Model.PatientGrowth.FirstOrDefault(point => point.Label == label)?.Count ?? 0).ToList(), jsonOptions));
    const appointments = @Html.Raw(JsonSerializer.Serialize(Model.AppointmentsByMonth.Select(point => point.Count).ToList(), jsonOptions));
    const loginCounts = @Html.Raw(JsonSerializer.Serialize(loginLabels.Select(label => Model.LoginsByMonth.FirstOrDefault(point => point.Label == label)?.Count ?? 0).ToList(), jsonOptions));
    const failedCounts = @Html.Raw(JsonSerializer.Serialize(loginLabels.Select(label => Model.FailedLoginsByMonth.FirstOrDefault(point => point.Label == label)?.Count ?? 0).ToList(), jsonOptions));

    const lineOptions = {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: { legend: { display: false } },
        scales: {
            x: { grid: { display: false }, ticks: { maxRotation: 0 } },
            y: { beginAtZero: true, grid: { color: '#f0f2f5' }, ticks: { precision: 0 } }
        }
    };
    const multiLineOptions = { ...lineOptions, plugins: { legend: { display: true, position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 14 } } } };
    const doughnutOptions = { responsive: true, maintainAspectRatio: false, cutout: '68%', plugins: { legend: { display: true, position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 12 } } } };
    const polarOptions = { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: true, position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 10 } } }, scales: { r: { beginAtZero: true, ticks: { display: false }, grid: { color: '#f0f2f5' } } } };
    const barOptions = { ...lineOptions, plugins: { legend: { display: false } } };
    const line = (id, datasets, chartLabels = labels, options = lineOptions) => new Chart(document.getElementById(id), { type: 'line', data: { labels: chartLabels, datasets }, options });

    line('growthChart', [
        { label: 'Revenue', data: revenue, borderColor: '#0b84ff', backgroundColor: 'rgba(11,132,255,.08)', borderWidth: 2, pointRadius: 3, pointBackgroundColor: '#0b84ff', fill: true, tension: .4 },
        { label: 'New patients', data: patients, borderColor: '#059669', backgroundColor: 'rgba(5,150,105,.08)', borderWidth: 2, pointRadius: 3, pointBackgroundColor: '#059669', fill: true, tension: .4 }
    ], labels, multiLineOptions);
    new Chart(document.getElementById('rolesChart'), { type: 'doughnut', data: { labels: @Html.Raw(JsonSerializer.Serialize(Model.UserRoles.Select(point => point.Label).ToList(), jsonOptions)), datasets: [{ data: @Html.Raw(JsonSerializer.Serialize(Model.UserRoles.Select(point => point.Count).ToList(), jsonOptions)), backgroundColor: ['#0b84ff','#059669','#f59e0b','#7c3aed','#ef4444'], borderWidth: 0, hoverOffset: 5 }] }, options: doughnutOptions });
    line('appointmentsChart', [{ label: 'Appointments', data: appointments, borderColor: '#7c3aed', backgroundColor: 'rgba(124,58,237,.08)', borderWidth: 2, pointRadius: 3, pointBackgroundColor: '#7c3aed', fill: true, tension: .4 }]);
    line('securityTrendChart', [
        { label: 'Successful logins', data: loginCounts, borderColor: '#059669', backgroundColor: 'rgba(5,150,105,.08)', borderWidth: 2, pointRadius: 3, pointBackgroundColor: '#059669', fill: true, tension: .4 },
        { label: 'Failed logins', data: failedCounts, borderColor: '#dc2626', backgroundColor: 'rgba(220,38,38,.06)', borderWidth: 2, pointRadius: 3, pointBackgroundColor: '#dc2626', fill: true, tension: .4 }
    ], loginLabels, multiLineOptions);
    new Chart(document.getElementById('auditChart'), { type: 'bar', data: { labels: @Html.Raw(JsonSerializer.Serialize(Model.AuditModules.Select(point => point.Label).ToList(), jsonOptions)), datasets: [{ label: 'Events', data: @Html.Raw(JsonSerializer.Serialize(Model.AuditModules.Select(point => point.Count).ToList(), jsonOptions)), backgroundColor: 'rgba(11,132,255,.15)', borderColor: '#0b84ff', borderWidth: 2, borderRadius: 5, borderSkipped: false }] }, options: barOptions });
    new Chart(document.getElementById('browserChart'), { type: 'polarArea', data: { labels: @Html.Raw(JsonSerializer.Serialize(Model.BrowserStats.Select(point => point.Label).ToList(), jsonOptions)), datasets: [{ data: @Html.Raw(JsonSerializer.Serialize(Model.BrowserStats.Select(point => point.Count).ToList(), jsonOptions)), backgroundColor: ['#0b84ff','#059669','#f59e0b','#7c3aed','#ef4444','#0891b2'], borderColor: '#fff', borderWidth: 2 }] }, options: polarOptions });
    new Chart(document.getElementById('accountSecurityChart'), { type: 'doughnut', data: { labels: ['Active accounts', 'Locked accounts'], datasets: [{ data: [@Model.ActiveUsers, @Model.LockedAccounts], backgroundColor: ['#059669','#dc2626'], borderWidth: 0, hoverOffset: 5 }] }, options: doughnutOptions });
</script>


