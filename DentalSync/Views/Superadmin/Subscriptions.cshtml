@model DentalSync.Controllers.SuperadminSubscriptionListViewModel
@{
    ViewData["Title"] = "Subscriptions & Billing";
    Layout = null;
    var list = Model.Items ?? new List<DentalSync.Controllers.SubscriptionViewModel>();
    var currentPage = Math.Max(1, Model.Page);
    var totalPages = Model.TotalPages;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);

    if (currentPage <= 3)
    {
        startPage = 1;
        endPage = Math.Min(5, totalPages);
    }

    if (currentPage >= totalPages - 2)
    {
        startPage = Math.Max(1, totalPages - 4);
        endPage = totalPages;
    }

    var pageNumbers = Enumerable.Range(startPage, endPage - startPage + 1).ToList();
    var showStartEllipsis = startPage > 2;
    var showEndEllipsis = endPage < totalPages - 1;
}

@await Html.PartialAsync("~/Views/Shared/SuperadminBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/users.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/SuperadminBars/_Sidebar.cshtml")
    <main class="users-page">

        <div class="users-page-heading">
            <div>
                <h1>Subscription &amp; Billing Monitor</h1>
                <p>Track active clinic subscription plans, monthly/annual revenue, plan renewals, and billing invoices.</p>
            </div>
            <div class="users-heading-actions">
                <span class="users-total">@Model.TotalSubscriptions subscriptions</span>
            </div>
        </div>

        <section class="users-panel" aria-label="Subscription plans list">
            <form method="get" asp-controller="Superadmin" asp-action="Subscriptions" class="users-filters">
                <label class="users-search">
                    <span class="sr-only">Search clinic subscriptions</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                    <input type="search" name="search" value="@ViewBag.Search" placeholder="Search clinic name or email" />
                </label>
                <label>
                    <span class="sr-only">Filter by plan</span>
                    <select name="plan">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Plan))">All plans</option>
                        <option value="Starter Clinic" selected="@(ViewBag.Plan == "Starter Clinic")">Starter Clinic</option>
                        <option value="Essential Clinic" selected="@(ViewBag.Plan == "Essential Clinic")">Essential Clinic</option>
                        <option value="Premium Clinic" selected="@(ViewBag.Plan == "Premium Clinic")">Premium Clinic</option>
                    </select>
                </label>
                <label>
                    <span class="sr-only">Filter by billing cycle</span>
                    <select name="billing">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Billing))">All billing</option>
                        <option value="Monthly" selected="@(ViewBag.Billing == "Monthly")">Monthly</option>
                        <option value="Annual" selected="@(ViewBag.Billing == "Annual")">Annual</option>
                    </select>
                </label>
                <label>
                    <span class="sr-only">Filter by status</span>
                    <select name="status">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Status))">All statuses</option>
                        <option value="active" selected="@(ViewBag.Status == "active")">Active</option>
                        <option value="suspended" selected="@(ViewBag.Status == "suspended")">Suspended</option>
                    </select>
                </label>
                <button type="submit" class="users-filter-button">Apply filters</button>
                <a asp-controller="Superadmin" asp-action="Subscriptions" class="users-clear-button">Clear</a>
            </form>

            <div class="users-table-wrap">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>Clinic Administrator</th>
                            <th>Email Address</th>
                            <th>Subscription Plan</th>
                            <th>Billing Cycle</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!list.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align:center; padding:32px; color:#6b7280;">
                                    No clinic subscriptions found in the database.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in list)
                            {
                                var initials = !string.IsNullOrWhiteSpace(item.ClinicName) && item.ClinicName.Length >= 2 
                                    ? item.ClinicName.Substring(0, 2).ToUpper() 
                                    : "CL";

                                <tr>
                                    <td>
                                        <div class="user-cell">
                                            <span class="user-avatar">@initials</span>
                                            <span>
                                                <strong>@item.ClinicName</strong>
                                                <small>Clinic Account</small>
                                            </span>
                                        </div>
                                    </td>
                                    <td>@item.Email</td>
                                    <td>
                                        <span class="role-pill">
                                            @item.Plan
                                        </span>
                                    </td>
                                    <td>@item.Billing</td>
                                    <td>
                                        @if (item.IsSuspended)
                                        {
                                            <span class="status-pill status-inactive">Suspended</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-active">Active</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="users-pagination" aria-label="Subscription pages">
                    <span>Showing @((Model.Page - 1) * Model.PageSize + (Model.TotalSubscriptions == 0 ? 0 : 1))–@Math.Min(Model.Page * Model.PageSize, Model.TotalSubscriptions) of @Model.TotalSubscriptions</span>
                    <div class="pagination-controls">
                        <a class="page-nav @(currentPage == 1 ? "disabled" : "")"
                           asp-controller="Superadmin"
                           asp-action="Subscriptions"
                           asp-route-search="@Model.Search"
                           asp-route-plan="@Model.Plan"
                           asp-route-billing="@Model.Billing"
                           asp-route-status="@Model.Status"
                           asp-route-page="@(Math.Max(1, currentPage - 1))"
                           aria-label="Previous page">‹</a>

                        @if (showStartEllipsis)
                        {
                            <a class="page-button"
                               asp-controller="Superadmin"
                               asp-action="Subscriptions"
                               asp-route-search="@Model.Search"
                               asp-route-plan="@Model.Plan"
                               asp-route-billing="@Model.Billing"
                               asp-route-status="@Model.Status"
                               asp-route-page="1">1</a>
                            <span class="page-ellipsis">…</span>
                        }

                        @foreach (var pageNumber in pageNumbers)
                        {
                            <a class="page-button @(pageNumber == currentPage ? "current" : "")"
                               asp-controller="Superadmin"
                               asp-action="Subscriptions"
                               asp-route-search="@Model.Search"
                               asp-route-plan="@Model.Plan"
                               asp-route-billing="@Model.Billing"
                               asp-route-status="@Model.Status"
                               asp-route-page="@pageNumber">@pageNumber</a>
                        }

                        @if (showEndEllipsis)
                        {
                            <span class="page-ellipsis">…</span>
                            <a class="page-button"
                               asp-controller="Superadmin"
                               asp-action="Subscriptions"
                               asp-route-search="@Model.Search"
                               asp-route-plan="@Model.Plan"
                               asp-route-billing="@Model.Billing"
                               asp-route-status="@Model.Status"
                               asp-route-page="@totalPages">@totalPages</a>
                        }

                        <a class="page-nav @(currentPage == totalPages ? "disabled" : "")"
                           asp-controller="Superadmin"
                           asp-action="Subscriptions"
                           asp-route-search="@Model.Search"
                           asp-route-plan="@Model.Plan"
                           asp-route-billing="@Model.Billing"
                           asp-route-status="@Model.Status"
                           asp-route-page="@(Math.Min(totalPages, currentPage + 1))"
                           aria-label="Next page">›</a>
                    </div>
                </nav>
            }
        </section>

    </main>
</div>
