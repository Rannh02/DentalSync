@model DentalSync.Models.TermsAndConditions
@{
    ViewData["Title"] = "Terms & Conditions Management";
    Layout = null;
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg = TempData["ErrorMessage"] as string;
}

@await Html.PartialAsync("~/Views/Shared/SuperadminBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/users.css" />
<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="stylesheet" href="~/css/superadmin.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/SuperadminBars/_Sidebar.cshtml")
    <main class="users-page">

        <div class="users-page-heading">
            <div>
                <h1>Checkout Terms &amp; Conditions</h1>
                <p>Manage the official Subscription Terms and Conditions. Any changes saved here automatically apply to the Checkout Page when subscribing administrators proceed to payment.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(successMsg))
        {
            <div style="background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; padding:14px 20px; border-radius:10px; margin-bottom:24px; font-size:14px; font-weight:600; display:flex; align-items:center; gap:10px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>@successMsg</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div style="background:#fef2f2; border:1px solid #fecaca; color:#991b1b; padding:14px 20px; border-radius:10px; margin-bottom:24px; font-size:14px; font-weight:600; display:flex; align-items:center; gap:10px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>@errorMsg</span>
            </div>
        }

        <div class="tc-layout">
            <div class="users-panel tc-editor-card">
                <div class="tc-card-header">
                    <div class="tc-title-wrap">
                        <span class="tc-icon tc-icon-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </span>
                        <div>
                            <h2>Edit Terms &amp; Conditions</h2>
                        </div>
                    </div>
                    <span class="tc-chip">Last updated: @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                </div>

                <form method="post" asp-controller="Superadmin" asp-action="UpdateTermsAndConditions" class="tc-form">
                    @Html.AntiForgeryToken()

                    <div class="tc-field">
                        <label>Document Title</label>
                        <input type="text" id="termsTitleInput" name="title" value="@Model.Title" placeholder="e.g. DentalSync Subscription Terms & Conditions" required oninput="updateLivePreview()" />
                    </div>

                    <div class="tc-field">
                        <label>Terms &amp; Conditions Text / Content</label>
                        <textarea id="termsContentInput" name="content" rows="18" placeholder="Type or paste the official Terms and Conditions here..." required oninput="updateLivePreview()">@Model.Content</textarea>
                    </div>

                    <div class="tc-actions">
                        <button type="submit" class="users-add-button tc-save-button">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                            Save Terms &amp; Conditions
                        </button>
                    </div>
                </form>
            </div>

            <aside class="users-panel tc-preview-card">
                <div class="tc-card-header">
                    <div class="tc-title-wrap">
                        <span class="tc-icon tc-icon-green">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </span>
                        <div>
                            <h2>Live Checkout Preview</h2>
                        </div>
                    </div>
                    <span class="tc-status-pill">Active</span>
                </div>

                <div class="tc-preview-shell">
                    <div class="tc-preview-head">
                        <div class="tc-preview-badge">📜</div>
                        <div>
                            <h3 id="previewTitle">@Model.Title</h3>
                            <span id="previewDate">Effective as of @Model.UpdatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>

                    <div id="previewContent" class="tc-preview-content">@Model.Content</div>

                    <div class="tc-preview-check">
                        <input type="checkbox" checked disabled />
                        <span>Admin accepts these terms upon clicking “Continue to Payment”</span>
                    </div>
                </div>
            </aside>
        </div>

    </main>
</div>

<script>
    function updateLivePreview() {
        const titleVal = document.getElementById('termsTitleInput').value.trim();
        const contentVal = document.getElementById('termsContentInput').value;

        document.getElementById('previewTitle').textContent = titleVal || "DentalSync Subscription Terms & Conditions";
        document.getElementById('previewContent').textContent = contentVal || "No content provided yet.";
    }
</script>
