@model DentalSync.ViewModels.ResetUserPasswordViewModel
@{ Layout = null; }
@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/users.css" />
<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Sidebar.cshtml")
    <main class="users-page"><a asp-action="Users" class="back-link">&larr; Back to users</a><section class="user-form-card"><h1>Reset password</h1><p class="form-help">Set a new password for <strong>@Model.UserName</strong>.</p><form method="post" asp-action="ResetUserPassword"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="form-error"></div><label asp-for="NewPassword"></label><input asp-for="NewPassword" /><span asp-validation-for="NewPassword" class="form-error"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword" class="form-error"></span><div class="detail-actions"><button type="submit" class="users-filter-button">Update password</button><a asp-action="Users" class="users-clear-button">Cancel</a></div></form></section></main>
</div>
@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Footer.cshtml")
