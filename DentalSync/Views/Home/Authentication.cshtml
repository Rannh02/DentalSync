@model DentalSync.ViewModels.AuthenticationLogViewModel
@{ Layout = null; }

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/users.css" />
<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="stylesheet" href="~/css/authentication.css" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Sidebar.cshtml")
    <main class="users-page">
        <div class="users-page-heading">
            <div>
                <h1>Authentication Logs</h1>
                <p>Monitor logins, logouts, session states, and lockouts.</p>
            </div>
            <div class="users-heading-actions">
                <span class="users-total">@Model.TotalLogs entries</span>
            </div>
        </div>



        <section class="users-panel" aria-label="Authentication log management">

            @*-- Filter bar --*@
            <form method="get" asp-controller="Home" asp-action="Authentication" class="users-filters">
                <label class="users-search">
                    <span class="sr-only">Search auth logs</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                    <input type="search" name="search" value="@Model.Search" placeholder="Search by user or description" />
                </label>
                <label>
                    <span class="sr-only">Filter by role</span>
                    <select name="role">
                        <option value="">All Roles</option>
                        @foreach (var r in Model.Roles)
                        {
                            <option value="@r" selected="@(Model.Role == r)">@r</option>
                        }
                    </select>
                </label>
                <button type="submit" class="users-filter-button">Apply Filters</button>
                <a asp-controller="Home" asp-action="Authentication" class="users-clear-button">Clear</a>
            </form>

            @*-- Table --*@
            <div class="users-table-wrap">
                <table class="users-table auth-table">
                    <colgroup>
                        <col class="auth-col-datetime" />
                        <col class="auth-col-user" />
                        <col class="auth-col-event" />
                        <col class="auth-col-status" />
                        <col class="auth-col-ip" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Date &amp; Time</th>
                            <th>User</th>
                            <th>Event</th>
                            <th>Status</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="users-empty">
                                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Role))
                                    {
                                        <span>No authentication logs match the selected filters.</span>
                                    }
                                    else
                                    {
                                        <span>No authentication events recorded yet.</span>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model.Logs)
                            {
                                <tr>
                                    <td class="audit-datetime">@log.DateTime.ToString("MMM dd, h:mm tt")</td>
                                    <td><strong>@log.User</strong></td>
                                    <td><span class="auth-event-pill auth-event-@log.Event.ToLower()">@log.Event</span></td>
                                    <td><span class="auth-status-pill auth-status-@log.Status.ToLower()">@log.Status</span></td>
                                    <td class="audit-ip">@log.IpAddress</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @*-- Pagination --*@
            @if (Model.TotalPages > 1)
            {
                <nav class="users-pagination" aria-label="Authentication log pages">
                    <span>Showing @((Model.Page - 1) * Model.PageSize + (Model.TotalLogs == 0 ? 0 : 1))–@Math.Min(Model.Page * Model.PageSize, Model.TotalLogs) of @Model.TotalLogs</span>
                    <div>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <a class="@(p == Model.Page ? "current" : "")"
                               asp-controller="Home" asp-action="Authentication"
                               asp-route-search="@Model.Search"
                               asp-route-role="@Model.Role"
                               asp-route-page="@p">@p</a>
                        }
                    </div>
                </nav>
            }

        </section>
    </main>
</div>

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Footer.cshtml")
