@model DentalSync.ViewModels.ServiceManagementViewModel
@{
    Layout = null;
}

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/users.css" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Sidebar.cshtml")
    <main class="users-page">
        <div class="users-page-heading">
            <div>
                <h1>Manage Services</h1>
                <p>Configure available dental procedures, pricing, and estimated durations.</p>
            </div>
            <div class="users-heading-actions">
                <span class="users-total">@Model.TotalServices services</span>
                <button type="button" class="users-add-button" id="openCreateService">+ Add service</button>
            </div>
        </div>

        @if (TempData["ServiceSuccess"] != null)
        {
            <div class="modal-error" style="background: #e9f9ee; color: #158a3e; margin-bottom: 18px;">
                @TempData["ServiceSuccess"]
            </div>
        }

        @if (TempData["ServiceError"] != null)
        {
            <div class="modal-error" style="margin-bottom: 18px;">
                @TempData["ServiceError"]
            </div>
        }

        <section class="users-panel" aria-label="Services management">
            <form method="get" asp-controller="Home" asp-action="Services" class="users-filters">
                <label class="users-search">
                    <span class="sr-only">Search services</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                    <input type="search" name="search" value="@Model.Search" placeholder="Search service name or description..." />
                </label>
                <label>
                    <span class="sr-only">Filter by status</span>
                    <select name="status">
                        <option value="">All statuses</option>
                        <option value="active" selected="@(Model.Status == "active")">Active</option>
                        <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
                    </select>
                </label>
                <button type="submit" class="users-filter-button">Apply filters</button>
                @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status))
                {
                    <a asp-controller="Home" asp-action="Services" class="users-clear-button">Clear</a>
                }
            </form>

            <div class="users-table-wrap">
                <table class="users-table">
                    <colgroup>
                        <col style="width: 15%;" />
                        <col style="width: 25%;" />
                        <col style="width: 25%;" />
                        <col style="width: 12%;" />
                        <col style="width: 8%;" />
                        <col style="width: 15%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Service Name</th>
                            <th>Description</th>
                            <th>Cost</th>
                            <th>Status</th>
                            <th class="users-actions-heading">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Services.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="users-empty">No services match the selected criteria.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Services)
                            {
                                <tr>
                                    <td><span class="role-pill">@item.Category</span></td>
                                    <td><strong>@item.Name</strong><small style="display: block; color: #6b7280;">@item.EstimatedDurationMinutes mins</small></td>
                                    <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                    <td><strong style="color: #158a3e;">₱@item.Cost.ToString("N2")</strong></td>
                                    <td>
                                        <span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")">
                                            @(item.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="user-actions">
                                            <button type="button" class="action-button action-edit btn-edit-service"
                                                    data-id="@item.Id"
                                                    data-name="@item.Name"
                                                    data-category="@item.Category"
                                                    data-description="@item.Description"
                                                    data-cost="@item.Cost"
                                                    data-duration="@item.EstimatedDurationMinutes">
                                                Edit
                                            </button>
                                            <form method="post" asp-controller="Services" asp-action="ToggleStatus" asp-route-id="@item.Id">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-button action-status">
                                                    @(item.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                            <form method="post" asp-controller="Services" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Are you sure you want to delete this service?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-button action-reset" style="border-color: #fceaea; color: #c22a2a;">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="users-pagination" aria-label="Services pages">
                    <span>Showing @((Model.Page - 1) * Model.PageSize + (Model.TotalServices == 0 ? 0 : 1))-@Math.Min(Model.Page * Model.PageSize, Model.TotalServices) of @Model.TotalServices</span>
                    <div>
                        @for (var page = 1; page <= Model.TotalPages; page++)
                        {
                            <a class="@(page == Model.Page ? "current" : "")" asp-controller="Home" asp-action="Services" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(page)">@(page)</a>
                        }
                    </div>
                </nav>
            }
        </section>
    </main>
</div>

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Footer.cshtml")

<!-- Add Service Modal -->
<div class="user-modal" id="createServiceModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="createServiceTitle">
    <div class="user-modal-backdrop" data-close-service-modal></div>
    <section class="user-modal-card">
        <div class="user-modal-header">
            <div>
                <h2 id="createServiceTitle">Add new service</h2>
                <p>Select a procedure from the predefined dentist service catalog.</p>
            </div>
            <button type="button" class="user-modal-close" data-close-service-modal aria-label="Close">&times;</button>
        </div>
        <form method="post" asp-controller="Services" asp-action="Create" class="create-user-form">
            @Html.AntiForgeryToken()
            <div class="modal-section-title">Service Details</div>
            
            <label for="createServiceName">Service Name *</label>
            <select id="createServiceName" name="Name" required style="width: 100%; height: 40px; border: 1px solid #dfe3e8; border-radius: 7px; background: #fff; color: #14181f; font: inherit; font-size: 13px; outline: none; padding: 0 10px;">
                <option value="">-- Select Dental Service --</option>
                <optgroup label="Preventive">
                    <option value="Dental Checkup" data-category="Preventive" data-cost="500">Dental Checkup (₱500)</option>
                    <option value="Teeth Cleaning / Scaling" data-category="Preventive" data-cost="800">Teeth Cleaning / Scaling (₱800)</option>
                    <option value="Fluoride Treatment" data-category="Preventive" data-cost="500">Fluoride Treatment (₱500)</option>
                    <option value="Dental Sealants" data-category="Preventive" data-cost="700">Dental Sealants (₱700)</option>
                    <option value="Oral Cancer Screening" data-category="Preventive" data-cost="500">Oral Cancer Screening (₱500)</option>
                    <option value="Dental X-Ray" data-category="Preventive" data-cost="500">Dental X-Ray (₱500)</option>
                </optgroup>
                <optgroup label="Restorative">
                    <option value="Tooth-Colored Filling" data-category="Restorative" data-cost="1000">Tooth-Colored Filling (₱1,000)</option>
                    <option value="Dental Crown" data-category="Restorative" data-cost="8000">Dental Crown (₱8,000)</option>
                    <option value="Dental Bridge" data-category="Restorative" data-cost="15000">Dental Bridge (₱15,000)</option>
                    <option value="Full Dentures" data-category="Restorative" data-cost="15000">Full Dentures (₱15,000)</option>
                    <option value="Partial Dentures" data-category="Restorative" data-cost="10000">Partial Dentures (₱10,000)</option>
                    <option value="Root Canal Treatment" data-category="Restorative" data-cost="8000">Root Canal Treatment (₱8,000)</option>
                    <option value="Inlay / Onlay" data-category="Restorative" data-cost="6000">Inlay / Onlay (₱6,000)</option>
                </optgroup>
                <optgroup label="Cosmetic">
                    <option value="Teeth Whitening" data-category="Cosmetic" data-cost="8000">Teeth Whitening (₱8,000)</option>
                    <option value="Dental Veneers" data-category="Cosmetic" data-cost="10000">Dental Veneers (₱10,000)</option>
                    <option value="Cosmetic Bonding" data-category="Cosmetic" data-cost="2500">Cosmetic Bonding (₱2,500)</option>
                    <option value="Tooth Reshaping" data-category="Cosmetic" data-cost="2000">Tooth Reshaping (₱2,000)</option>
                    <option value="Smile Makeover" data-category="Cosmetic" data-cost="30000">Smile Makeover (₱30,000)</option>
                </optgroup>
                <optgroup label="Orthodontics">
                    <option value="Traditional Braces" data-category="Orthodontics" data-cost="50000">Traditional Braces (₱50,000)</option>
                    <option value="Ceramic Braces" data-category="Orthodontics" data-cost="60000">Ceramic Braces (₱60,000)</option>
                    <option value="Clear Aligners" data-category="Orthodontics" data-cost="80000">Clear Aligners (₱80,000)</option>
                    <option value="Retainers" data-category="Orthodontics" data-cost="5000">Retainers (₱5,000)</option>
                </optgroup>
                <optgroup label="Oral Surgery">
                    <option value="Simple Tooth Extraction" data-category="Oral Surgery" data-cost="1500">Simple Tooth Extraction (₱1,500)</option>
                    <option value="Wisdom Tooth Extraction" data-category="Oral Surgery" data-cost="5000">Wisdom Tooth Extraction (₱5,000)</option>
                    <option value="Dental Implant" data-category="Oral Surgery" data-cost="60000">Dental Implant (₱60,000)</option>
                    <option value="Bone Grafting" data-category="Oral Surgery" data-cost="15000">Bone Grafting (₱15,000)</option>
                </optgroup>
                <optgroup label="Gum Care">
                    <option value="Deep Cleaning" data-category="Gum Care" data-cost="2500">Deep Cleaning (₱2,500)</option>
                    <option value="Scaling & Root Planing" data-category="Gum Care" data-cost="3000">Scaling & Root Planing (₱3,000)</option>
                    <option value="Gum Surgery" data-category="Gum Care" data-cost="10000">Gum Surgery (₱10,000)</option>
                    <option value="Gum Grafting" data-category="Gum Care" data-cost="15000">Gum Grafting (₱15,000)</option>
                </optgroup>
                <optgroup label="Pediatric">
                    <option value="Children's Dental Checkup" data-category="Pediatric" data-cost="400">Children's Dental Checkup (₱400)</option>
                    <option value="Children's Teeth Cleaning" data-category="Pediatric" data-cost="600">Children's Teeth Cleaning (₱600)</option>
                    <option value="Children's Filling" data-category="Pediatric" data-cost="800">Children's Filling (₱800)</option>
                    <option value="Space Maintainer" data-category="Pediatric" data-cost="3000">Space Maintainer (₱3,000)</option>
                </optgroup>
                <optgroup label="Emergency">
                    <option value="Emergency Consultation" data-category="Emergency" data-cost="500">Emergency Consultation (₱500)</option>
                    <option value="Toothache Treatment" data-category="Emergency" data-cost="1000">Toothache Treatment (₱1,000)</option>
                    <option value="Broken/Chipped Tooth Treatment" data-category="Emergency" data-cost="2000">Broken/Chipped Tooth Treatment (₱2,000)</option>
                    <option value="Abscess Treatment" data-category="Emergency" data-cost="2500">Abscess Treatment (₱2,500)</option>
                    <option value="Lost Filling/Crown Treatment" data-category="Emergency" data-cost="1500">Lost Filling/Crown Treatment (₱1,500)</option>
                </optgroup>
                <optgroup label="Specialized">
                    <option value="TMJ Treatment" data-category="Specialized" data-cost="5000">TMJ Treatment (₱5,000)</option>
                    <option value="Night Guard" data-category="Specialized" data-cost="3500">Night Guard (₱3,500)</option>
                    <option value="Sleep Apnea Appliance" data-category="Specialized" data-cost="15000">Sleep Apnea Appliance (₱15,000)</option>
                </optgroup>
            </select>

            <label for="createServiceCategory">Category</label>
            <input id="createServiceCategory" name="Category" required readonly style="background: #f8fafc; color: #475569;" placeholder="Auto-populated on selection" />

            <label for="createServiceDescription">Description</label>
            <input id="createServiceDescription" name="Description" maxlength="500" placeholder="Brief details about procedure..." />
            
            <label for="createServiceCost">Cost (₱)</label>
            <input id="createServiceCost" name="Cost" type="number" step="0.01" min="0" required placeholder="0.00" />
            
            <label for="createServiceDuration">Est. Duration (Minutes)</label>
            <input id="createServiceDuration" name="EstimatedDurationMinutes" type="number" min="1" max="1440" value="30" required />

            <div class="user-modal-actions">
                <button type="button" class="users-clear-button" data-close-service-modal>Cancel</button>
                <button type="submit" class="users-filter-button">Create Service</button>
            </div>
        </form>
    </section>
</div>

<!-- Edit Service Modal -->
<div class="user-modal" id="editServiceModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="editServiceTitle">
    <div class="user-modal-backdrop" data-close-service-modal></div>
    <section class="user-modal-card">
        <div class="user-modal-header">
            <div>
                <h2 id="editServiceTitle">Edit service</h2>
                <p>Update procedure specifications and pricing.</p>
            </div>
            <button type="button" class="user-modal-close" data-close-service-modal aria-label="Close">&times;</button>
        </div>
        <form method="post" asp-controller="Services" asp-action="Edit" class="create-user-form">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editServiceId" name="Id" />
            <div class="modal-section-title">Service Details</div>
            
            <label for="editServiceName">Service Name</label>
            <input id="editServiceName" name="Name" required maxlength="100" />
            
            <label for="editServiceCategory">Category</label>
            <input id="editServiceCategory" name="Category" required maxlength="100" />

            <label for="editServiceDescription">Description</label>
            <input id="editServiceDescription" name="Description" maxlength="500" />
            
            <label for="editServiceCost">Cost (₱)</label>
            <input id="editServiceCost" name="Cost" type="number" step="0.01" min="0" required />
            
            <label for="editServiceDuration">Est. Duration (Minutes)</label>
            <input id="editServiceDuration" name="EstimatedDurationMinutes" type="number" min="1" max="1440" required />

            <div class="user-modal-actions">
                <button type="button" class="users-clear-button" data-close-service-modal>Cancel</button>
                <button type="submit" class="users-filter-button">Save Changes</button>
            </div>
        </form>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var createModal = document.getElementById('createServiceModal');
        var editModal = document.getElementById('editServiceModal');
        var openCreateBtn = document.getElementById('openCreateService');
        var closeBtns = document.querySelectorAll('[data-close-service-modal]');
        var createServiceNameSelect = document.getElementById('createServiceName');

        if (createServiceNameSelect) {
            createServiceNameSelect.addEventListener('change', function () {
                var selectedOption = this.options[this.selectedIndex];
                var category = selectedOption.getAttribute('data-category') || '';
                var cost = selectedOption.getAttribute('data-cost') || '';
                
                document.getElementById('createServiceCategory').value = category;
                if (cost) {
                    document.getElementById('createServiceCost').value = cost;
                }
            });
        }

        if (openCreateBtn && createModal) {
            openCreateBtn.addEventListener('click', function () {
                createModal.classList.add('is-open');
            });
        }

        closeBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (createModal) createModal.classList.remove('is-open');
                if (editModal) editModal.classList.remove('is-open');
            });
        });

        document.querySelectorAll('.btn-edit-service').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('editServiceId').value = this.getAttribute('data-id');
                document.getElementById('editServiceName').value = this.getAttribute('data-name');
                document.getElementById('editServiceCategory').value = this.getAttribute('data-category') || '';
                document.getElementById('editServiceDescription').value = this.getAttribute('data-description') || '';
                document.getElementById('editServiceCost').value = this.getAttribute('data-cost');
                document.getElementById('editServiceDuration').value = this.getAttribute('data-duration');
                if (editModal) editModal.classList.add('is-open');
            });
        });
    });
</script>
