@model DentalSync.ViewModels.ServiceManagementViewModel
@{
    Layout = null;
}

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/users.css" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Sidebar.cshtml")
    <main class="users-page">
        <div class="users-page-heading">
            <div>
                <h1>Manage Services</h1>
                <p>Configure available dental procedures, pricing, and estimated durations.</p>
            </div>
            <div class="users-heading-actions">
                <span class="users-total">@Model.TotalServices services</span>
                <button type="button" class="users-add-button" id="openCreateService">+ Add service</button>
            </div>
        </div>

        @if (TempData["ServiceSuccess"] != null)
        {
            <div class="modal-error" style="background: #e9f9ee; color: #158a3e; margin-bottom: 18px;">
                @TempData["ServiceSuccess"]
            </div>
        }

        @if (TempData["ServiceError"] != null)
        {
            <div class="modal-error" style="margin-bottom: 18px;">
                @TempData["ServiceError"]
            </div>
        }

        <section class="users-panel" aria-label="Services management">
            <form method="get" asp-controller="Home" asp-action="Services" class="users-filters">
                <label class="users-search">
                    <span class="sr-only">Search services</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                    <input type="search" name="search" value="@Model.Search" placeholder="Search service name or description..." />
                </label>
                <label>
                    <span class="sr-only">Filter by status</span>
                    <select name="status">
                        <option value="">All statuses</option>
                        <option value="active" selected="@(Model.Status == "active")">Active</option>
                        <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
                    </select>
                </label>
                <button type="submit" class="users-filter-button">Apply filters</button>
                @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status))
                {
                    <a asp-controller="Home" asp-action="Services" class="users-clear-button">Clear</a>
                }
            </form>

            <div class="users-table-wrap">
                <table class="users-table">
                    <colgroup>
                        <col style="width: 25%;" />
                        <col style="width: 30%;" />
                        <col style="width: 15%;" />
                        <col style="width: 15%;" />
                        <col style="width: 15%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Service Name</th>
                            <th>Description</th>
                            <th>Cost</th>
                            <th>Status</th>
                            <th class="users-actions-heading">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Services.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="users-empty">No services match the selected criteria.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Services)
                            {
                                <tr>
                                    <td><strong>@item.Name</strong><small style="color: #6b7280;">@item.EstimatedDurationMinutes mins</small></td>
                                    <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                    <td><strong style="color: #158a3e;">₱@item.Cost.ToString("N2")</strong></td>
                                    <td>
                                        <span class="status-pill @(item.IsActive ? "status-active" : "status-inactive")">
                                            @(item.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="user-actions">
                                            <button type="button" class="action-button action-edit btn-edit-service"
                                                    data-id="@item.Id"
                                                    data-name="@item.Name"
                                                    data-description="@item.Description"
                                                    data-cost="@item.Cost"
                                                    data-duration="@item.EstimatedDurationMinutes">
                                                Edit
                                            </button>
                                            <form method="post" asp-controller="Services" asp-action="ToggleStatus" asp-route-id="@item.Id">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-button action-status">
                                                    @(item.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                            <form method="post" asp-controller="Services" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Are you sure you want to delete this service?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-button action-reset" style="border-color: #fceaea; color: #c22a2a;">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="users-pagination" aria-label="Services pages">
                    <span>Showing @((Model.Page - 1) * Model.PageSize + (Model.TotalServices == 0 ? 0 : 1))-@Math.Min(Model.Page * Model.PageSize, Model.TotalServices) of @Model.TotalServices</span>
                    <div>
                        @for (var page = 1; page <= Model.TotalPages; page++)
                        {
                            <a class="@(page == Model.Page ? "current" : "")" asp-controller="Home" asp-action="Services" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(page)">@(page)</a>
                        }
                    </div>
                </nav>
            }
        </section>
    </main>
</div>

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Footer.cshtml")

<!-- Add Service Modal -->
<div class="user-modal" id="createServiceModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="createServiceTitle">
    <div class="user-modal-backdrop" data-close-service-modal></div>
    <section class="user-modal-card">
        <div class="user-modal-header">
            <div>
                <h2 id="createServiceTitle">Add new service</h2>
                <p>Define procedure details, duration, and pricing.</p>
            </div>
            <button type="button" class="user-modal-close" data-close-service-modal aria-label="Close">&times;</button>
        </div>
        <form method="post" asp-controller="Services" asp-action="Create" class="create-user-form">
            @Html.AntiForgeryToken()
            <div class="modal-section-title">Service Details</div>
            <label for="createServiceName">Service Name</label>
            <input id="createServiceName" name="Name" required maxlength="100" placeholder="e.g. Tooth Extraction" />
            
            <label for="createServiceDescription">Description</label>
            <input id="createServiceDescription" name="Description" maxlength="500" placeholder="Brief details about procedure..." />
            
            <label for="createServiceCost">Cost (₱)</label>
            <input id="createServiceCost" name="Cost" type="number" step="0.01" min="0" required placeholder="0.00" />
            
            <label for="createServiceDuration">Est. Duration (Minutes)</label>
            <input id="createServiceDuration" name="EstimatedDurationMinutes" type="number" min="1" max="1440" value="30" required />

            <div class="user-modal-actions">
                <button type="button" class="users-clear-button" data-close-service-modal>Cancel</button>
                <button type="submit" class="users-filter-button">Create Service</button>
            </div>
        </form>
    </section>
</div>

<!-- Edit Service Modal -->
<div class="user-modal" id="editServiceModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="editServiceTitle">
    <div class="user-modal-backdrop" data-close-service-modal></div>
    <section class="user-modal-card">
        <div class="user-modal-header">
            <div>
                <h2 id="editServiceTitle">Edit service</h2>
                <p>Update procedure specifications and pricing.</p>
            </div>
            <button type="button" class="user-modal-close" data-close-service-modal aria-label="Close">&times;</button>
        </div>
        <form method="post" asp-controller="Services" asp-action="Edit" class="create-user-form">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editServiceId" name="Id" />
            <div class="modal-section-title">Service Details</div>
            <label for="editServiceName">Service Name</label>
            <input id="editServiceName" name="Name" required maxlength="100" />
            
            <label for="editServiceDescription">Description</label>
            <input id="editServiceDescription" name="Description" maxlength="500" />
            
            <label for="editServiceCost">Cost (₱)</label>
            <input id="editServiceCost" name="Cost" type="number" step="0.01" min="0" required />
            
            <label for="editServiceDuration">Est. Duration (Minutes)</label>
            <input id="editServiceDuration" name="EstimatedDurationMinutes" type="number" min="1" max="1440" required />

            <div class="user-modal-actions">
                <button type="button" class="users-clear-button" data-close-service-modal>Cancel</button>
                <button type="submit" class="users-filter-button">Save Changes</button>
            </div>
        </form>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var createModal = document.getElementById('createServiceModal');
        var editModal = document.getElementById('editServiceModal');
        var openCreateBtn = document.getElementById('openCreateService');
        var closeBtns = document.querySelectorAll('[data-close-service-modal]');

        if (openCreateBtn && createModal) {
            openCreateBtn.addEventListener('click', function () {
                createModal.classList.add('is-open');
            });
        }

        closeBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (createModal) createModal.classList.remove('is-open');
                if (editModal) editModal.classList.remove('is-open');
            });
        });

        document.querySelectorAll('.btn-edit-service').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('editServiceId').value = this.getAttribute('data-id');
                document.getElementById('editServiceName').value = this.getAttribute('data-name');
                document.getElementById('editServiceDescription').value = this.getAttribute('data-description') || '';
                document.getElementById('editServiceCost').value = this.getAttribute('data-cost');
                document.getElementById('editServiceDuration').value = this.getAttribute('data-duration');
                if (editModal) editModal.classList.add('is-open');
            });
        });
    });
</script>
