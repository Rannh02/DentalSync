@model DentalSync.ViewModels.ReportsViewModel
@{ Layout = null; }

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/reports.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Sidebar.cshtml")

    <main class="rp-page">

        <!-- ── Page heading ───────────────────────────────────────────── -->
        <div class="rp-heading">
            <div>
                <h1>Reports &amp; Analytics</h1>
                <p>Operational overview · @Model.DateFrom.ToString("MMM dd") – @Model.DateTo.ToString("MMM dd, yyyy")</p>
            </div>

            <!-- Date-range filter -->
            <div class="rp-filter-bar">
                <a href="?preset=today"
                   class="rp-preset-btn @(Model.Preset == "today" ? "active" : "")">Today</a>
                <a href="?preset=week"
                   class="rp-preset-btn @(Model.Preset == "week" ? "active" : "")">This Week</a>
                <a href="?preset=month"
                   class="rp-preset-btn @(Model.Preset == "month" ? "active" : "")">This Month</a>

                <div class="rp-separator"></div>

                <form method="get">
                    <input type="hidden" name="preset" value="custom" />
                    <input type="date" name="from" class="rp-date-input"
                           value="@(Model.Preset == "custom" ? Model.DateFrom.ToString("yyyy-MM-dd") : "")"
                           title="From date" />
                    <span style="font-size:12px;color:#94a3b8;">–</span>
                    <input type="date" name="to" class="rp-date-input"
                           value="@(Model.Preset == "custom" ? Model.DateTo.ToString("yyyy-MM-dd") : "")"
                           title="To date" />
                    <button type="submit" class="rp-preset-btn @(Model.Preset == "custom" ? "active" : "")">Apply</button>
                </form>


            </div>
        </div>

        <!-- ── KPI Cards ────────────────────────────────────────────────── -->
        <div class="rp-kpi-grid rp-section">

            @{
                string DeltaHtml(double? d)
                {
                    if (!d.HasValue) return "<span class=\"rp-kpi-delta flat\">–</span>";
                    var cls = d > 0 ? "up" : d < 0 ? "down" : "flat";
                    var arrow = d > 0 ? "▲" : d < 0 ? "▼" : "–";
                    return $"<span class=\"rp-kpi-delta {cls}\">{arrow} {Math.Abs(d.Value):0.#}%</span>";
                }
            }

            <div class="rp-kpi-card rp-kpi-revenue">
                <div class="rp-kpi-label">Total Revenue</div>
                <div class="rp-kpi-value">₱@Model.Kpi.TotalRevenue.ToString("N0")</div>
                @Html.Raw(DeltaHtml(Model.Kpi.RevenueDelta))
            </div>

            <div class="rp-kpi-card rp-kpi-appts">
                <div class="rp-kpi-label">Appointments</div>
                <div class="rp-kpi-value">@Model.Kpi.TotalAppointments</div>
                @Html.Raw(DeltaHtml(Model.Kpi.AppointmentsDelta))
            </div>

            <div class="rp-kpi-card rp-kpi-patients">
                <div class="rp-kpi-label">New Patients</div>
                <div class="rp-kpi-value">@Model.Kpi.NewPatients</div>
                @Html.Raw(DeltaHtml(Model.Kpi.PatientsDelta))
            </div>

            <div class="rp-kpi-card rp-kpi-treats">
                <div class="rp-kpi-label">Treatments Done</div>
                <div class="rp-kpi-value">@Model.Kpi.CompletedTreatments</div>
                @Html.Raw(DeltaHtml(Model.Kpi.TreatmentsDelta))
            </div>

            <div class="rp-kpi-card rp-kpi-outstanding">
                <div class="rp-kpi-label">Outstanding</div>
                <div class="rp-kpi-value">₱@Model.Kpi.OutstandingPayments.ToString("N0")</div>
                <span class="rp-kpi-delta flat">Unpaid balance</span>
            </div>

            <div class="rp-kpi-card rp-kpi-alerts">
                <div class="rp-kpi-label">Inventory Alerts</div>
                <div class="rp-kpi-value">@Model.Kpi.InventoryAlerts</div>
                <span class="rp-kpi-delta @(Model.Kpi.InventoryAlerts > 0 ? "down" : "up")">
                    @(Model.Kpi.InventoryAlerts > 0 ? "Needs attention" : "All good")
                </span>
            </div>
        </div>

        <!-- ── Revenue chart + Appointment status ────────────────────────── -->
        <div class="rp-analytics-grid rp-section">

            <!-- Revenue Over Time -->
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">Revenue Overview</div>
                        <div class="rp-panel-sub">Monthly collections · last 6 months</div>
                    </div>
                </div>
                <div class="rp-panel-body">
                    <div class="rp-chart-wrap">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Appointment Status Breakdown -->
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">Appointment Status</div>
                        <div class="rp-panel-sub">Distribution for current period</div>
                    </div>
                </div>
                <div class="rp-panel-body">
                    <div class="rp-chart-wrap" style="height:160px;margin-bottom:12px;">
                        <canvas id="apptChart"></canvas>
                    </div>
                    <div class="rp-appt-list">
                        <div class="rp-appt-row">
                            <span class="rp-appt-label"><span class="rp-appt-dot" style="background:#0b84ff;"></span>Scheduled</span>
                            <span class="rp-appt-count">@Model.AppointmentStats.Scheduled</span>
                        </div>
                        <div class="rp-appt-row">
                            <span class="rp-appt-label"><span class="rp-appt-dot" style="background:#7c3aed;"></span>Confirmed</span>
                            <span class="rp-appt-count">@Model.AppointmentStats.Confirmed</span>
                        </div>
                        <div class="rp-appt-row">
                            <span class="rp-appt-label"><span class="rp-appt-dot" style="background:#059669;"></span>Completed</span>
                            <span class="rp-appt-count">@Model.AppointmentStats.Completed</span>
                        </div>
                        <div class="rp-appt-row">
                            <span class="rp-appt-label"><span class="rp-appt-dot" style="background:#f59e0b;"></span>Cancelled</span>
                            <span class="rp-appt-count">@Model.AppointmentStats.Cancelled</span>
                        </div>
                        <div class="rp-appt-row">
                            <span class="rp-appt-label"><span class="rp-appt-dot" style="background:#ef4444;"></span>No-show</span>
                            <span class="rp-appt-count">@Model.AppointmentStats.NoShow</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Patient Growth + Top Services + Financial ─────────────────── -->
        <div class="rp-analytics-grid-3 rp-section">

            <!-- Patient Growth -->
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">Patient Growth</div>
                        <div class="rp-panel-sub">New registrations · last 6 months</div>
                    </div>
                </div>
                <div class="rp-panel-body">
                    <div class="rp-chart-wrap">
                        <canvas id="patientChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Top Dental Services -->
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">Top Services</div>
                        <div class="rp-panel-sub">By treatment count</div>
                    </div>
                </div>
                <div class="rp-panel-body" style="padding-top:10px;">
                    @if (Model.TopServices.Count == 0)
                    {
                        <div class="rp-empty">No treatment data for this period.</div>
                    }
                    else
                    {
                        <div class="rp-service-list">
                            @foreach (var svc in Model.TopServices)
                            {
                                <div class="rp-service-row">
                                    <span class="rp-service-name">@svc.ServiceName</span>
                                    <span class="rp-service-count">@svc.Count×</span>
                                    <span class="rp-service-rev">₱@svc.Revenue.ToString("N0")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Financial Breakdown -->
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">Financial Summary</div>
                        <div class="rp-panel-sub">Invoice &amp; payment breakdown</div>
                    </div>
                </div>
                <div class="rp-panel-body">
                    <div class="rp-stats-grid" style="margin-bottom:16px;">
                        <div class="rp-stat-item">
                            <div class="rp-stat-item-label">Paid</div>
                            <div class="rp-stat-item-value green">₱@Model.Financial.PaidInvoices.ToString("N0")</div>
                        </div>
                        <div class="rp-stat-item">
                            <div class="rp-stat-item-label">Unpaid</div>
                            <div class="rp-stat-item-value red">₱@Model.Financial.UnpaidInvoices.ToString("N0")</div>
                        </div>
                        <div class="rp-stat-item">
                            <div class="rp-stat-item-label">Partial</div>
                            <div class="rp-stat-item-value amber">₱@Model.Financial.PartiallyPaid.ToString("N0")</div>
                        </div>
                        <div class="rp-stat-item">
                            <div class="rp-stat-item-label">Collected</div>
                            <div class="rp-stat-item-value" style="color:#0b84ff;">₱@Model.Financial.TotalRevenue.ToString("N0")</div>
                        </div>
                    </div>

                    @if (Model.Financial.PaymentMethods.Count > 0)
                    {
                        var maxAmt = Model.Financial.PaymentMethods.Max(m => m.Value);
                        <div style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px;">Payment Methods</div>
                        <div class="rp-method-list">
                            @foreach (var m in Model.Financial.PaymentMethods.OrderByDescending(x => x.Value))
                            {
                                var pct = maxAmt == 0 ? 0 : (int)(m.Value / maxAmt * 100);
                                <div class="rp-method-row">
                                    <div class="rp-method-label-row">
                                        <span>@m.Label</span>
                                        <span style="font-weight:600;color:#0b1220;">₱@m.Value.ToString("N0")</span>
                                    </div>
                                    <div class="rp-method-bar-track">
                                        <div class="rp-method-bar-fill" style="width:@pct%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ── Security Overview ─────────────────────────────────────────── -->
        <div class="rp-section-title-bar">
            <h2>Security &amp; Session Analytics</h2>
        </div>

        <!-- Security KPIs -->
        <div class="rp-security-kpis rp-section">
            <div class="rp-kpi-card rp-kpi-active-sessions">
                <div class="rp-kpi-label">Active Sessions (Online)</div>
                <div class="rp-kpi-value">@Model.ActiveSessions</div>
                <span class="rp-kpi-delta flat">Current online users</span>
            </div>

            <div class="rp-kpi-card rp-kpi-failed-logins">
                <div class="rp-kpi-label">Failed Logins</div>
                <div class="rp-kpi-value">@Model.FailedLogins</div>
                <span class="rp-kpi-delta flat">Total recorded failures</span>
            </div>

            <div class="rp-kpi-card rp-kpi-locked-accounts">
                <div class="rp-kpi-label">Locked Accounts</div>
                <div class="rp-kpi-value">@Model.LockedAccounts</div>
                <span class="rp-kpi-delta flat">Currently locked out</span>
            </div>
        </div>

        <!-- Security Graphs Grid -->
        <div class="rp-security-grid rp-section">
            <!-- User Logins Over Time -->
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">User Logins</div>
                        <div class="rp-panel-sub">Successful logins · last 6 months</div>
                    </div>
                </div>
                <div class="rp-panel-body">
                    <div class="rp-chart-wrap">
                        <canvas id="loginsChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Failed Logins (Bruteforce attempts) -->
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">Failed Logins &amp; Bruteforce Attempts</div>
                        <div class="rp-panel-sub">Failed authentication logs · last 6 months</div>
                    </div>
                </div>
                <div class="rp-panel-body">
                    <div class="rp-chart-wrap">
                        <canvas id="failedLoginsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Browser Usage Pie Chart -->
        <div class="rp-section">
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">Browser Usage</div>
                        <div class="rp-panel-sub">Top browsers by session activity · all-time</div>
                    </div>
                </div>
                <div class="rp-panel-body" style="display:flex;align-items:center;gap:32px;flex-wrap:wrap;">
                    @if (Model.BrowserStats.Count == 0)
                    {
                        <div class="rp-empty" style="width:100%;">No browser data recorded yet.</div>
                    }
                    else
                    {
                        <div style="width:220px;height:220px;flex-shrink:0;">
                            <canvas id="browserChart"></canvas>
                        </div>
                        <div class="rp-browser-legend">
                            @{
                                var browserColors = new[] { "#0b84ff", "#7c3aed", "#059669", "#f59e0b", "#ef4444", "#06b6d4", "#64748b" };
                                var totalBrowserCount = Model.BrowserStats.Sum(b => b.Count);
                                int bIdx = 0;
                            }
                            @foreach (var b in Model.BrowserStats)
                            {
                                var pct = totalBrowserCount == 0 ? 0 : Math.Round((double)b.Count / totalBrowserCount * 100, 1);
                                var color = browserColors[bIdx % browserColors.Length];
                                bIdx++;
                                <div class="rp-browser-row">
                                    <span class="rp-browser-dot" style="background:@color;"></span>
                                    <span class="rp-browser-name">@b.Label</span>
                                    <span class="rp-browser-pct">@pct%</span>
                                    <span class="rp-browser-count">@b.Count sessions</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ── Inventory Analytics ────────────────────────────────────────── -->
        <div class="rp-section">
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">Inventory Analytics</div>
                        <div class="rp-panel-sub">Current supply status overview</div>
                    </div>
                    <a asp-controller="Inventory" asp-action="DentalSupplies" class="rp-preset-btn">
                        View Supplies →
                    </a>
                </div>
                <div class="rp-panel-body">
                    <div class="rp-inv-grid">
                        <div class="rp-inv-card rp-inv-total">
                            <div class="rp-inv-card-label">Total Supplies</div>
                            <div class="rp-inv-card-value">@Model.InventoryStats.TotalSupplies</div>
                        </div>
                        <div class="rp-inv-card rp-inv-low">
                            <div class="rp-inv-card-label">Low Stock</div>
                            <div class="rp-inv-card-value">@Model.InventoryStats.LowStock</div>
                        </div>
                        <div class="rp-inv-card rp-inv-out">
                            <div class="rp-inv-card-label">Out of Stock</div>
                            <div class="rp-inv-card-value">@Model.InventoryStats.OutOfStock</div>
                        </div>
                        <div class="rp-inv-card rp-inv-expiring">
                            <div class="rp-inv-card-label">Expiring (30d)</div>
                            <div class="rp-inv-card-value">@Model.InventoryStats.ExpiringIn30Days</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Recent Invoices Table ──────────────────────────────────────── -->
        <div class="rp-section">
            <div class="rp-panel">
                <div class="rp-panel-header">
                    <div>
                        <div class="rp-panel-title">Recent Invoices</div>
                        <div class="rp-panel-sub">@Model.TotalInvoices invoice(s) in current period</div>
                    </div>
                </div>

                <div class="rp-table-wrap">
                    <table class="rp-table">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Patient</th>
                                <th>Date</th>
                                <th style="text-align:right;">Total</th>
                                <th style="text-align:right;">Paid</th>
                                <th style="text-align:center;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentInvoices.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="rp-empty">No invoices found for this period.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var inv in Model.RecentInvoices)
                                {
                                    var statusClass = inv.Status switch
                                    {
                                        "Paid"          => "rp-inv-paid",
                                        "PartiallyPaid" => "rp-inv-partial",
                                        "Cancelled"     => "rp-inv-cancelled",
                                        _               => "rp-inv-pending"
                                    };
                                    var statusLabel = inv.Status == "PartiallyPaid" ? "Partial" : inv.Status;
                                    <tr>
                                        <td style="font-weight:600;color:#0b84ff;">#@inv.InvoiceNumber</td>
                                        <td>@inv.PatientName</td>
                                        <td style="white-space:nowrap;color:#64748b;">@inv.InvoiceDate.ToString("MMM dd, yyyy")</td>
                                        <td style="text-align:right;font-weight:600;">₱@inv.TotalAmount.ToString("N2")</td>
                                        <td style="text-align:right;color:#158a3e;font-weight:600;">₱@inv.PaidAmount.ToString("N2")</td>
                                        <td style="text-align:center;">
                                            <span class="rp-inv-status @statusClass">@statusLabel</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalInvoicePages > 1)
                {
                    <div class="rp-pagination">
                        <span>Showing @((Model.InvoicePage - 1) * Model.InvoicePageSize + (Model.TotalInvoices == 0 ? 0 : 1))–@Math.Min(Model.InvoicePage * Model.InvoicePageSize, Model.TotalInvoices) of @Model.TotalInvoices</span>
                        <div>
                            @for (var p = 1; p <= Model.TotalInvoicePages; p++)
                            {
                                <a class="@(p == Model.InvoicePage ? "current" : "")"
                                   asp-controller="Home" asp-action="Records"
                                   asp-route-preset="@Model.Preset"
                                   asp-route-invoicePage="@p">@p</a>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>

    </main>
</div>

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Footer.cshtml")

<script>
    // ── Shared chart defaults ───────────────────────────────────────────────
    Chart.defaults.font.family = "Inter, -apple-system, sans-serif";
    Chart.defaults.font.size   = 11;
    Chart.defaults.color       = "#94a3b8";

    // ── Revenue Bar Chart ───────────────────────────────────────────────────
    var revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.RevenueByMonth.Select(c => {
            var parts = c.Label.Split('-');
            return System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat
                .GetAbbreviatedMonthName(int.Parse(parts[1])) + " " + parts[0].Substring(2);
        }).ToList()));

    var revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.RevenueByMonth.Select(c => c.Value).ToList()));

    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels: revenueLabels,
            datasets: [{
                label: 'Revenue (₱)',
                data: revenueData,
                backgroundColor: 'rgba(11,132,255,0.15)',
                borderColor: '#0b84ff',
                borderWidth: 2,
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false } },
                y: {
                    grid: { color: '#f0f2f5' },
                    ticks: { callback: v => '₱' + v.toLocaleString() }
                }
            }
        }
    });

    // ── Appointment Doughnut ────────────────────────────────────────────────
    new Chart(document.getElementById('apptChart'), {
        type: 'doughnut',
        data: {
            labels: ['Scheduled', 'Confirmed', 'Completed', 'Cancelled', 'No-show'],
            datasets: [{
                data: [@Model.AppointmentStats.Scheduled, @Model.AppointmentStats.Confirmed,
                       @Model.AppointmentStats.Completed, @Model.AppointmentStats.Cancelled,
                       @Model.AppointmentStats.NoShow],
                backgroundColor: ['#0b84ff', '#7c3aed', '#059669', '#f59e0b', '#ef4444'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            cutout: '68%',
            plugins: { legend: { display: false } }
        }
    });

    // ── Patient Growth Line Chart ───────────────────────────────────────────
    var ptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.PatientGrowth.Select(c => {
            var parts = c.Label.Split('-');
            return System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat
                .GetAbbreviatedMonthName(int.Parse(parts[1])) + " " + parts[0].Substring(2);
        }).ToList()));

    var ptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.PatientGrowth.Select(c => c.Count).ToList()));

    new Chart(document.getElementById('patientChart'), {
        type: 'line',
        data: {
            labels: ptLabels,
            datasets: [{
                label: 'New Patients',
                data: ptData,
                borderColor: '#059669',
                backgroundColor: 'rgba(5,150,105,0.08)',
                borderWidth: 2,
                pointRadius: 4,
                pointBackgroundColor: '#059669',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false } },
                y: { grid: { color: '#f0f2f5' }, ticks: { stepSize: 1 } }
            }
        }
    });

    // ── User Logins Line Chart ──────────────────────────────────────────────
    var loginsLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.LoginsByMonth.Select(c => {
            var parts = c.Label.Split('-');
            return System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat
                .GetAbbreviatedMonthName(int.Parse(parts[1])) + " " + parts[0].Substring(2);
        }).ToList()));

    var loginsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.LoginsByMonth.Select(c => c.Count).ToList()));

    new Chart(document.getElementById('loginsChart'), {
        type: 'line',
        data: {
            labels: loginsLabels,
            datasets: [{
                label: 'Logins',
                data: loginsData,
                borderColor: '#0b84ff',
                backgroundColor: 'rgba(11,132,255,0.08)',
                borderWidth: 2,
                pointRadius: 4,
                pointBackgroundColor: '#0b84ff',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false } },
                y: { grid: { color: '#f0f2f5' }, ticks: { stepSize: 1 } }
            }
        }
    });

    // ── Failed Logins Bar Chart ─────────────────────────────────────────────
    var failedLoginsLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.FailedLoginsByMonth.Select(c => {
            var parts = c.Label.Split('-');
            return System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat
                .GetAbbreviatedMonthName(int.Parse(parts[1])) + " " + parts[0].Substring(2);
        }).ToList()));

    var failedLoginsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.FailedLoginsByMonth.Select(c => c.Count).ToList()));

    new Chart(document.getElementById('failedLoginsChart'), {
        type: 'bar',
        data: {
            labels: failedLoginsLabels,
            datasets: [{
                label: 'Failed Logins',
                data: failedLoginsData,
                backgroundColor: 'rgba(239,68,68,0.15)',
                borderColor: '#ef4444',
                borderWidth: 2,
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false } },
                y: { grid: { color: '#f0f2f5' }, ticks: { stepSize: 1 } }
            }
        }
    });

    // ── Browser Usage Pie Chart ─────────────────────────────────────────────
    (function () {
        var ctx = document.getElementById('browserChart');
        if (!ctx) return;
        var browserLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BrowserStats.Select(b => b.Label).ToList()));
        var browserCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BrowserStats.Select(b => b.Count).ToList()));
        var browserColors = ['#0b84ff','#7c3aed','#059669','#f59e0b','#ef4444','#06b6d4','#64748b'];
        var sliceColors = browserLabels.map(function(_, i) { return browserColors[i % browserColors.length]; });

        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: browserLabels,
                datasets: [{
                    data: browserCounts,
                    backgroundColor: sliceColors,
                    borderColor: '#fff',
                    borderWidth: 2,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                var total = ctx.dataset.data.reduce(function(a, b) { return a + b; }, 0);
                                var pct = total > 0 ? (ctx.parsed / total * 100).toFixed(1) : 0;
                                return ' ' + ctx.label + ': ' + ctx.parsed + ' (' + pct + '%)';
                            }
                        }
                    }
                }
            }
        });
    })();
</script>
