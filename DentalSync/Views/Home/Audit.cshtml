@model DentalSync.ViewModels.AuditLogViewModel
@{ Layout = null; }

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/users.css" />
<link rel="stylesheet" href="~/css/audit.css" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Sidebar.cshtml")
    <main class="users-page">
        <div class="users-page-heading">
            <div>
                <h1>Audit Logs</h1>
                <p>Track all system activity, user actions, and security events.</p>
            </div>
            <div class="users-heading-actions">
                <span class="users-total">@Model.TotalLogs entries</span>
            </div>
        </div>

        <section class="users-panel" aria-label="Audit log management">

            @*-- Filter bar --*@
            <form method="get" asp-controller="Audit" asp-action="Audit" class="users-filters">
                <label class="users-search">
                    <span class="sr-only">Search audit logs</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                    <input type="search" name="search" value="@Model.Search" placeholder="Search by user, action, or module" />
                </label>
                <label>
                    <span class="sr-only">Filter by role</span>
                    <select name="role">
                        <option value="">All Roles</option>
                        @foreach (var r in Model.Roles)
                        {
                            <option value="@r" selected="@(Model.Role == r)">@r</option>
                        }
                    </select>
                </label>
                <button type="submit" class="users-filter-button">Apply Filters</button>
                <a asp-controller="Audit" asp-action="Audit" class="users-clear-button">Clear</a>
            </form>

            @*-- Table --*@
            <div class="users-table-wrap">
                <table class="users-table audit-table">
                    <colgroup>
                        <col class="audit-col-datetime" />
                        <col class="audit-col-user" />
                        <col class="audit-col-role" />
                        <col class="audit-col-action" />
                        <col class="audit-col-module" />
                        <col class="audit-col-desc" />
                        <col class="audit-col-ip" />
                        <col class="audit-col-browser" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Date &amp; Time</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Action</th>
                            <th>Module</th>
                            <th>Description</th>
                            <th>IP Address</th>
                            <th>Browser</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="users-empty">
                                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Role))
                                    {
                                        <span>No audit logs match the selected filters.</span>
                                    }
                                    else
                                    {
                                        <span>No audit log entries yet. Activity will appear here once users start interacting with the system.</span>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model.Logs)
                            {
                                <tr>
                                    <td class="audit-datetime">@log.DateTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                                    <td><strong>@log.User</strong></td>
                                    <td><span class="role-pill">@log.Role</span></td>
                                    <td><span class="audit-action-pill audit-action-@log.Action.ToLower()">@log.Action</span></td>
                                    <td>@log.Module</td>
                                    <td class="audit-desc">@log.Description</td>
                                    <td class="audit-ip">@log.IpAddress</td>
                                    <td>
                                        @{
                                            var b = log.Browser;
                                            var bClass = b switch {
                                                "Chrome"           => "browser-chrome",
                                                "Microsoft Edge"   => "browser-edge",
                                                "Firefox"          => "browser-firefox",
                                                "Safari"           => "browser-safari",
                                                "Opera"            => "browser-opera",
                                                "Internet Explorer"=> "browser-ie",
                                                _                  => "browser-other"
                                            };
                                        }
                                        <span class="browser-pill @bClass">
                                            @(string.IsNullOrEmpty(b) ? "Unknown" : b)
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @*-- Pagination --*@
            @if (Model.TotalPages > 1)
            {
                var currentPage = Math.Max(1, Model.Page);
                var totalPages = Model.TotalPages;
                var startPage = Math.Max(1, currentPage - 2);
                var endPage = Math.Min(totalPages, currentPage + 2);

                if (currentPage <= 3)
                {
                    startPage = 1;
                    endPage = Math.Min(5, totalPages);
                }

                if (currentPage >= totalPages - 2)
                {
                    startPage = Math.Max(1, totalPages - 4);
                    endPage = totalPages;
                }

                var pageNumbers = Enumerable.Range(startPage, endPage - startPage + 1).ToList();
                var showStartEllipsis = startPage > 2;
                var showEndEllipsis = endPage < totalPages - 1;

                <nav class="users-pagination" aria-label="Audit log pages">
                    <span>Showing @((Model.Page - 1) * Model.PageSize + (Model.TotalLogs == 0 ? 0 : 1))–@Math.Min(Model.Page * Model.PageSize, Model.TotalLogs) of @Model.TotalLogs</span>
                    <div class="pagination-controls">
                        <a class="page-nav @(currentPage == 1 ? "disabled" : "")"
                           asp-controller="Audit"
                           asp-action="Audit"
                           asp-route-search="@Model.Search"
                           asp-route-role="@Model.Role"
                           asp-route-page="@(Math.Max(1, currentPage - 1))"
                           aria-label="Previous page">‹</a>

                        @if (showStartEllipsis)
                        {
                            <a class="page-button"
                               asp-controller="Audit"
                               asp-action="Audit"
                               asp-route-search="@Model.Search"
                               asp-route-role="@Model.Role"
                               asp-route-page="1">1</a>
                            <span class="page-ellipsis">…</span>
                        }

                        @foreach (var p in pageNumbers)
                        {
                            <a class="page-button @(p == currentPage ? "current" : "")"
                               asp-controller="Audit"
                               asp-action="Audit"
                               asp-route-search="@Model.Search"
                               asp-route-role="@Model.Role"
                               asp-route-page="@p">@p</a>
                        }

                        @if (showEndEllipsis)
                        {
                            <span class="page-ellipsis">…</span>
                            <a class="page-button"
                               asp-controller="Audit"
                               asp-action="Audit"
                               asp-route-search="@Model.Search"
                               asp-route-role="@Model.Role"
                               asp-route-page="@totalPages">@totalPages</a>
                        }

                        <a class="page-nav @(currentPage == totalPages ? "disabled" : "")"
                           asp-controller="Audit"
                           asp-action="Audit"
                           asp-route-search="@Model.Search"
                           asp-route-role="@Model.Role"
                           asp-route-page="@(Math.Min(totalPages, currentPage + 1))"
                           aria-label="Next page">›</a>
                    </div>
                </nav>
            }

        </section>
    </main>
</div>

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Footer.cshtml")
