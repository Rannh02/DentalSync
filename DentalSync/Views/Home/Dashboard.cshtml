@model DentalSync.ViewModels.AdminDashboardViewModel
@{
    Layout = null;
}
@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Header.cshtml")

<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Sidebar.cshtml")

    <div class="dc-wrap">
        <h2>Welcome back, <span class="ds-brand-accent">@ViewBag.UserFullName!</span></h2>
        <p class="dc-subtitle">Here’s what’s happening across the clinic today.</p>

        <!-- KPI Cards -->
        <div class="dc-kpi-grid">

            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    </div>
                    <span class="dc-kpi-delta dc-delta-up">Active</span>
                </div>
                <div class="dc-kpi-value">@(Model?.TotalPatients.ToString("N0") ?? "0")</div>
                <div class="dc-kpi-label">Patients</div>
            </div>

            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-teal">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                    </div>
                    <span class="dc-kpi-delta dc-delta-flat">Today</span>
                </div>
                <div class="dc-kpi-value">@(Model?.TodayAppointmentsCount.ToString("N0") ?? "0")</div>
                <div class="dc-kpi-label">Appointments</div>
            </div>

            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-green">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                    </div>
                    <span class="dc-kpi-delta dc-delta-up">Total</span>
                </div>
                <div class="dc-kpi-value">₱@(Model?.TotalRevenue.ToString("N2") ?? "0.00")</div>
                <div class="dc-kpi-label">Revenue</div>
            </div>

            <div class="dc-kpi-card">
                <div class="dc-kpi-top">
                    <div class="dc-kpi-icon dc-icon-amber">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 10h18M6 14h12M6 18h12" /><path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" /></svg>
                    </div>
                    <span class="dc-kpi-delta dc-delta-down">Needs attention</span>
                </div>
                <div class="dc-kpi-value">₱@(Model?.PendingPayments.ToString("N2") ?? "0.00")</div>
                <div class="dc-kpi-label">Pending Payments</div>
            </div>

        </div>

        <!-- Today's appointments and recent activity -->
        <div class="dc-lower-grid">
            <div class="dc-lower-column">
                <div class="dc-panel">
                    <div class="dc-panel-header">
                        <span class="dc-panel-title">Today's Appointments</span>
                        <a asp-controller="Receptionist" asp-action="ManageAppointments" class="dc-panel-link">View all</a>
                    </div>
                    <div class="dc-appt-list">
                        @if (Model?.TodayAppointments != null && Model.TodayAppointments.Any())
                        {
                            @foreach (var appt in Model.TodayAppointments)
                            {
                                var timeFormatted = DateTime.Today.Add(appt.StartTime.ToTimeSpan()).ToString("h:mm tt");
                                <div class="dc-appt-row">
                                    <div class="dc-avatar">@appt.Initials</div>
                                    <div class="dc-appt-info">
                                        <div class="dc-appt-name">@appt.PatientName</div>
                                        <div class="dc-appt-service">@appt.ServiceName · @appt.DentistName</div>
                                        <div class="dc-appt-booked" style="font-size: 11px; color: #64748b; margin-top: 2px;">
                                            Booked: @appt.CreatedAt.ToString("MMM dd, yyyy h:mm tt")
                                        </div>
                                    </div>
                                    <div class="dc-appt-time">
                                        @timeFormatted<br />
                                        <span class="dc-status @appt.StatusCssClass">@appt.Status</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="dc-appt-row" style="justify-content: center; padding: 24px 0; color: #64748b;">
                                No appointments scheduled for today.
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="dc-lower-column">
                <div class="dc-panel">
                    <div class="dc-panel-header">
                        <span class="dc-panel-title">Recent Activity</span>
                        <a asp-controller="Home" asp-action="Audit" class="dc-panel-link">View all</a>
                    </div>
                    <div class="dc-activity-list">
                        @if (Model?.RecentActivities != null && Model.RecentActivities.Any())
                        {
                            @foreach (var activity in Model.RecentActivities)
                            {
                                <div class="dc-activity-row">
                                    <div class="dc-activity-icon @activity.IconCssClass">@activity.Icon</div>
                                    <div class="dc-activity-info">
                                        <strong>@activity.Action</strong>
                                        <span>@activity.Description</span>
                                    </div>
                                    <time title="@activity.Timestamp.ToString("F")">@activity.RelativeTimeText</time>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="dc-activity-row" style="justify-content: center; padding: 24px 0; color: #64748b;">
                                No recent activity logged.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Footer.cshtml")

