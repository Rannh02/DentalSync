@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    Layout = null;
    ViewData["Title"] = "Subscribe - DentalSync Clinic";
    string plan = (TempData["Plan"] as string) ?? (ViewBag.Plan as string) ?? "Starter Clinic";
    string billing = (TempData["Billing"] as string) ?? (ViewBag.Billing as string) ?? "monthly";
    string priceStr = (TempData["Price"] as string) ?? (ViewBag.Price as string) ?? "799";
    decimal price = 0;
    decimal.TryParse(priceStr, out price);
    string registerError = TempData["RegisterError"] as string;
    string registerSuccess = TempData["RegisterSuccess"] as string;
    var tokens = Antiforgery.GetAndStoreTokens(Context);

    string termsTitle = (ViewBag.TermsTitle as string) ?? "DentalSync Subscription Terms & Conditions";
    string termsContent = (ViewBag.TermsContent as string) ?? "";
    string termsUpdatedAt = (ViewBag.TermsUpdatedAt as string) ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subscribe to @plan - DentalSync</title>
    <link rel="stylesheet" href="~/css/CheckoutPage.css" asp-append-version="true" />
</head>
<body>

    <!-- NAV -->
    <nav class="checkout-nav">
        <a asp-controller="LandingPage" asp-action="Promotionpage" class="checkout-logo">
            <span class="logo-text">Dental<span>Sync</span> Clinic</span>
        </a>

        <a asp-controller="LandingPage" asp-action="SubscriptionPage" class="checkout-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Change Plan
        </a>
    </nav>

    <!-- CONTAINER -->
    <div class="checkout-container">

        <!-- STEP INDICATOR -->
        <div class="checkout-steps">
            <div class="step-item active" id="step-pill-1">
                <span class="step-number" id="num-1">1</span>
                <span>Admin Account</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item" id="step-pill-2">
                <span class="step-number" id="num-2">2</span>
                <span>Payment &amp; Setup</span>
            </div>
        </div>

        <div class="checkout-grid">

            <!-- LEFT: FORM STEPS -->
            <div class="checkout-main">
                
                <!-- STEP 1: ADMIN REGISTRATION -->
                <div class="checkout-card" id="step-content-1">
                    <h2 class="card-title">Register Admin Account</h2>
                    <p class="card-subtitle">Set up the primary administrator account for your clinic management system.</p>

                    @if (!string.IsNullOrEmpty(registerError))
                    {
                        <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:8px;padding:14px;font-size:13px;color:#991b1b;margin-bottom:18px;">
                            ⚠️ @registerError
                        </div>
                    }

                    <form id="admin-reg-form" onsubmit="handleStep1Submit(event)">
                        <!-- FIRST NAME, MIDDLE NAME, LAST NAME -->
                        <div class="form-group-row-3">
                            <div class="form-group">
                                <label for="firstName">First Name *</label>
                                <input type="text" id="firstName" class="form-input" placeholder="Juan" required />
                            </div>
                            <div class="form-group">
                                <label for="middleName">Middle Name</label>
                                <input type="text" id="middleName" class="form-input" placeholder="Santos" />
                            </div>
                            <div class="form-group">
                                <label for="lastName">Last Name *</label>
                                <input type="text" id="lastName" class="form-input" placeholder="Dela Cruz" required />
                            </div>
                        </div>

                        <!-- CURRENT ADDRESS -->
                        <div class="form-group">
                            <label for="currentAddress">Current Address *</label>
                            <input type="text" id="currentAddress" class="form-input" placeholder="House/Bldg No., Street, Barangay, City, Province" required />
                        </div>

                        <!-- CONTACT NUMBER & EMAIL ADDRESS -->
                        <div class="form-group-row">
                            <div class="form-group">
                                <label for="adminPhone">Contact / Mobile Number *</label>
                                <input type="tel" id="adminPhone" class="form-input" placeholder="0917 123 4567" required />
                            </div>
                            <div class="form-group">
                                <label for="adminEmail">Email Address (Login Username) *</label>
                                <input type="email" id="adminEmail" class="form-input" placeholder="admin@clinic.ph" required />
                            </div>
                        </div>

                        <!-- PASSWORD & CONFIRM PASSWORD WITH STRENGTH BAR -->
                        <div class="form-group-row">
                            <div class="form-group">
                                <label for="adminPassword">Password *</label>
                                <input type="password" id="adminPassword" class="form-input" placeholder="At least 12 chars (A-z, 0-9, special)" minlength="12" required />
                                <div class="password-strength" aria-live="polite">
                                    <div class="password-strength-track"><span id="adminPasswordStrengthBar"></span></div>
                                    <strong id="adminPasswordStrengthLabel">Enter a password</strong>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="adminConfirmPassword">Confirm Password *</label>
                                <input type="password" id="adminConfirmPassword" class="form-input" placeholder="Re-enter password" required />
                            </div>
                        </div>

                        <button type="submit" class="btn-checkout-primary">
                            Continue to Payment
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M5 12h14M12 5l7 7-7 7"/>
                            </svg>
                        </button>
                    </form>

                </div>

                <!-- STEP 2: PAYMENT METHOD -->
                <div class="checkout-card" id="step-content-2" style="display: none;">
                    <h2 class="card-title">Choose Payment Option</h2>
                    <p class="card-subtitle">Select your payment method. You will be redirected to PayMongo's secure checkout to complete your transaction.</p>

                    <!-- METHOD SELECTOR OPTIONS (GCash, Credit/Debit Card, Maya) -->
                    <div class="payment-methods">
                        <div class="payment-method-card selected" id="method-gcash" onclick="selectPaymentMethod('gcash')">
                            <div class="payment-icon">📱</div>
                            <div class="payment-info">
                                <span class="payment-title">GCash E-Wallet</span>
                                <span class="payment-sub">Instant PH mobile payment</span>
                            </div>
                        </div>

                        <div class="payment-method-card" id="method-card" onclick="selectPaymentMethod('card')">
                            <div class="payment-icon">💳</div>
                            <div class="payment-info">
                                <span class="payment-title">Credit / Debit Card</span>
                                <span class="payment-sub">Visa, Mastercard, JCB</span>
                            </div>
                        </div>

                        <div class="payment-method-card" id="method-paymaya" onclick="selectPaymentMethod('paymaya')">
                            <div class="payment-icon">💚</div>
                            <div class="payment-info">
                                <span class="payment-title">Maya E-Wallet</span>
                                <span class="payment-sub">Instant Maya mobile payment</span>
                            </div>
                        </div>
                    </div>

                    <!-- PAYMONGO FORM -->
                    <form id="payment-card-form" method="post" action="/LandingPage/CreateCheckoutSession">
                        <input type="hidden" name="__RequestVerificationToken" value="@tokens.RequestToken" />

                        <!-- Hidden fields populated from Step 1 -->
                        <input type="hidden" id="h-fullName"      name="fullName"  />
                        <input type="hidden" id="h-email"         name="email"     />
                        <input type="hidden" id="h-password"      name="password"  />
                        <input type="hidden" id="h-paymentMethod" name="paymentMethod" value="gcash" />
                        <input type="hidden" name="plan"          value="@plan"    />
                        <input type="hidden" name="billing"       value="@billing" />
                        <input type="hidden" name="price"         value="@priceStr" />

                        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 16px; margin: 20px 0; font-size: 13.5px; color: #166534; display: flex; align-items: center; justify-content: space-between;">
                            <div style="display:flex; align-items:center; gap:12px;">
                                <div style="font-size: 24px;">🛡️</div>
                                <div>
                                    <strong>Secured by PayMongo Gateway</strong>
                                    <br />
                                    Direct, end-to-end 256-bit encrypted checkout with instant transaction verification.
                                </div>
                            </div>
                            <button type="button" onclick="openTermsModal()" style="background:#e0f2fe; border:1px solid #bae6fd; color:#0369a1; padding:6px 12px; border-radius:6px; font-size:12px; font-weight:600; cursor:pointer; white-space:nowrap;">
                                📜 Review Terms
                            </button>
                        </div>

                        <div class="form-actions-inline">
                            <button type="button" onclick="goToStep(1)" class="btn-checkout-secondary">
                                ← Back to Account Info
                            </button>
                            <button type="submit" class="btn-checkout-primary" style="margin-top:0;">
                                Pay via PayMongo (₱@price.ToString("N0"))
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M5 12h14M12 5l7 7-7 7"/>
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>

            </div>

            <!-- RIGHT: ORDER SUMMARY -->
            <div class="checkout-sidebar">
                <div class="summary-card">
                    <div class="summary-header">
                        <span>Order Summary</span>
                        <span class="plan-badge-pill">@billing.ToUpper()</span>
                    </div>

                    <div class="summary-row">
                        <span>Selected Plan</span>
                        <strong style="color: var(--dark-blue);">@plan</strong>
                    </div>

                    <div class="summary-row">
                        <span>Billing Cycle</span>
                        <span>@(billing == "annual" ? "Annual (Save 20%)" : "Monthly")</span>
                    </div>

                    <div class="summary-row">
                        <span>Setup & Admin License</span>
                        <span style="color: #16a34a; font-weight: 600;">FREE</span>
                    </div>

                    <div class="summary-row total">
                        <span>Total Due Today</span>
                        <span class="summary-total-amount">₱@price.ToString("N0")</span>
                    </div>

                    <div class="summary-perks">
                        <div class="summary-perk-item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            Instant Admin Dashboard access
                        </div>
                        <div class="summary-perk-item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            256-bit encrypted data protection
                        </div>
                        <div class="summary-perk-item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            Cancel or change plan anytime
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- TERMS AND CONDITIONS MODAL -->
    <div class="modal-overlay" id="termsModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(15,23,42,0.65); backdrop-filter:blur(4px); z-index:9999; align-items:center; justify-content:center; padding:20px;">
        <div style="background:#ffffff; border-radius:16px; max-width:680px; width:100%; max-height:85vh; display:flex; flex-direction:column; box-shadow:0 25px 50px -12px rgba(0,0,0,0.25); overflow:hidden; animation: modalFadeIn 0.25s ease-out;">
            <div style="padding:22px 28px; border-bottom:1px solid #e2e8f0; background:#f8fafc; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <h3 style="font-size:18px; font-weight:700; color:#0f172a; margin:0 0 4px;">@termsTitle</h3>
                    <span style="font-size:12.5px; color:#64748b;">Official Subscription Policy &bull; Last Updated: @termsUpdatedAt</span>
                </div>
                <button type="button" onclick="closeTermsModal()" style="background:none; border:none; font-size:24px; color:#64748b; cursor:pointer; padding:0; line-height:1;">&times;</button>
            </div>

            <div style="padding:24px 28px; overflow-y:auto; font-size:13.5px; line-height:1.7; color:#334155; white-space:pre-wrap; font-family:'Inter', sans-serif; background:#ffffff; flex:1;">@termsContent</div>

            <div style="padding:20px 28px; border-top:1px solid #e2e8f0; background:#f8fafc; display:flex; flex-direction:column; gap:14px;">
                <label style="display:flex; align-items:flex-start; gap:10px; font-size:13px; color:#1e293b; cursor:pointer; font-weight:500;">
                    <input type="checkbox" id="termsAgreeCheckbox" onchange="toggleTermsAcceptButton()" style="margin-top:3px; accent-color:#2563eb; width:17px; height:17px;" />
                    <span>I have read, understood, and accept the <strong>Terms and Conditions</strong> set by Superadmin for subscribing to DentalSync.</span>
                </label>

                <div style="display:flex; justify-content:flex-end; gap:12px;">
                    <button type="button" onclick="closeTermsModal()" class="btn-checkout-secondary" style="padding:10px 18px; font-size:13px;">
                        Back
                    </button>
                    <button type="button" id="btnAcceptTerms" onclick="confirmTermsAndProceed()" class="btn-checkout-primary" disabled style="padding:10px 22px; font-size:13.5px; opacity:0.5; margin-top:0;">
                        Accept
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="successModal">
        <div class="modal-box">
            <div class="modal-icon-success">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>
            <h3 class="modal-title">Subscription Confirmed!</h3>
            <p class="modal-desc">
                Welcome to <strong>DentalSync Clinic</strong>. Your admin account has been successfully created and your subscription is active.
            </p>
            <a asp-controller="Account" asp-action="Login" class="btn-checkout-primary" style="text-decoration: none;">
                Proceed to Login Dashboard
            </a>
        </div>
    </div>

    <script>
        let currentStep = 1;
        let selectedMethod = 'card';

        function goToStep(step) {
            currentStep = step;

            document.getElementById('step-content-1').style.display = step === 1 ? 'block' : 'none';
            document.getElementById('step-content-2').style.display = step === 2 ? 'block' : 'none';

            const pill1 = document.getElementById('step-pill-1');
            const pill2 = document.getElementById('step-pill-2');

            if (step === 1) {
                pill1.className = 'step-item active';
                pill2.className = 'step-item';
            } else {
                pill1.className = 'step-item completed';
                pill2.className = 'step-item active';
            }
        }

        function handleStep1Submit(e) {
            e.preventDefault();

            const firstName  = document.getElementById('firstName').value.trim();
            const middleName = document.getElementById('middleName').value.trim();
            const lastName   = document.getElementById('lastName').value.trim();
            const pwd        = document.getElementById('adminPassword').value;
            const confirmPwd = document.getElementById('adminConfirmPassword').value;
            const email      = document.getElementById('adminEmail').value.trim();

            if (pwd !== confirmPwd) {
                alert('Passwords do not match. Please re-check your password.');
                return;
            }

            // Build full name and copy to hidden fields used by the real POST form
            const fullName = [firstName, middleName, lastName].filter(Boolean).join(' ');
            document.getElementById('h-fullName').value = fullName;
            document.getElementById('h-email').value    = email;
            document.getElementById('h-password').value = pwd;

            // Advance step indicator to Payment & Setup and show Terms & Conditions modal
            goToStep(2);
            openTermsModal();
        }

        function openTermsModal() {
            const modal = document.getElementById('termsModal');
            if (modal) {
                modal.classList.add('active');
                modal.style.display = 'flex';
                modal.style.opacity = '1';
                modal.style.pointerEvents = 'auto';
            }
        }

        function closeTermsModal() {
            const modal = document.getElementById('termsModal');
            if (modal) {
                modal.classList.remove('active');
                modal.style.display = 'none';
                modal.style.opacity = '0';
                modal.style.pointerEvents = 'none';
            }
        }

        function toggleTermsAcceptButton() {
            const chk = document.getElementById('termsAgreeCheckbox');
            const btn = document.getElementById('btnAcceptTerms');
            if (btn) {
                btn.disabled = !chk.checked;
                btn.style.opacity = chk.checked ? '1' : '0.5';
            }
        }

        function confirmTermsAndProceed() {
            closeTermsModal();
            goToStep(2);
        }

        function selectPaymentMethod(method) {
            selectedMethod = method;
            const hiddenField = document.getElementById('h-paymentMethod');
            if (hiddenField) hiddenField.value = method;

            const gcashPill = document.getElementById('method-gcash');
            const cardPill = document.getElementById('method-card');
            const mayaPill = document.getElementById('method-paymaya');

            if (gcashPill) gcashPill.className = (method === 'gcash') ? 'payment-method-card selected' : 'payment-method-card';
            if (cardPill) cardPill.className = (method === 'card') ? 'payment-method-card selected' : 'payment-method-card';
            if (mayaPill) mayaPill.className = (method === 'paymaya') ? 'payment-method-card selected' : 'payment-method-card';
        }

        // The payment form now submits directly to the server — no JS override needed.
        // We keep this stub in case it is called from elsewhere.
        function handleFinalSubmit(e) {
            // real form submission handled by the browser (POST to /LandingPage/RegisterAdmin)
        }

        // PASSWORD STRENGTH EVALUATOR
        const passwordInput = document.getElementById('adminPassword');
        const strengthBar = document.getElementById('adminPasswordStrengthBar');
        const strengthLabel = document.getElementById('adminPasswordStrengthLabel');

        if (passwordInput && strengthBar && strengthLabel) {
            passwordInput.addEventListener('input', function () {
                const password = passwordInput.value;
                let score = 0;
                if (password.length >= 12) score++;
                if (/[a-z]/.test(password)) score++;
                if (/[A-Z]/.test(password)) score++;
                if (/[0-9]/.test(password)) score++;
                if (/[^a-zA-Z0-9]/.test(password)) score++;

                const levels = [
                    { label: 'Enter a password', className: '', width: '0%' },
                    { label: 'Very weak', className: 'is-very-weak', width: '20%' },
                    { label: 'Weak', className: 'is-weak', width: '40%' },
                    { label: 'Fair', className: 'is-fair', width: '60%' },
                    { label: 'Strong', className: 'is-strong', width: '80%' },
                    { label: 'Very strong', className: 'is-very-strong', width: '100%' }
                ];
                const level = levels[password.length === 0 ? 0 : score];
                strengthBar.className = level.className;
                strengthBar.style.width = level.width;
                strengthLabel.textContent = level.label;
            });
        }
    </script>


</body>
</html>
