@{
    ViewData["Title"] = "DentalSync – Subscription Plans";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Choose the right DentalSync plan for your clinic. Flexible subscription plans with powerful dental management features." />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/SubscriptionPage.css" asp-append-version="true" />
</head>
<body>

    <!-- ============================================================
         NAV
    ============================================================ -->
    <nav class="sub-nav">
        <a asp-controller="LandingPage" asp-action="Promotionpage" class="sub-nav-logo">
            <span class="logo-text">Dental<span>Sync</span> Clinic</span>
        </a>

        <a asp-controller="LandingPage" asp-action="Promotionpage" class="sub-nav-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Back to Home
        </a>
    </nav>

    <!-- ============================================================
         HEADER
    ============================================================ -->
    <header class="sub-header">
        <div class="sub-header-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            Flexible Plans
        </div>
        <h1>Upgrade your clinic's plan</h1>
        <p>Start for free and scale as your clinic grows. All plans include core dental management tools.</p>

        <div>
            <div class="billing-toggle" id="billingToggle">
                <button class="toggle-btn active" id="btn-monthly" onclick="setBilling('monthly')">Monthly</button>
                <button class="toggle-btn" id="btn-annual" onclick="setBilling('annual')">Annual</button>
            </div>
            <span class="save-badge" id="save-badge" style="display:none;">Save 20%</span>
        </div>
    </header>

    <!-- ============================================================
         PLANS GRID
    ============================================================ -->
    <section class="plans-section">
        <div class="plans-grid">

            <!-- BASIC -->
            <div class="plan-card">
                <div class="plan-tier-row">
                    <span class="plan-tier">Basic</span>
                </div>
                <div class="plan-name">Starter Clinic</div>
                <div class="plan-desc">Everything you need to run a small clinic smoothly, with core management tools.</div>

                <div class="plan-price-block">
                    <span class="plan-currency">₱</span>
                    <span class="plan-amount" data-monthly="799" data-annual="639">799</span>
                    <span class="plan-period">/ month</span>
                </div>
                <div class="plan-annual-note" id="note-basic">&nbsp;</div>

                <button type="button" onclick="selectPlan('Starter Clinic', 799, 639)" class="plan-btn btn-outline" style="cursor:pointer; width:100%;">
                    Get Started
                </button>

                <div class="plan-divider"></div>
                <div class="plan-features-label">Core features included:</div>
                <ul class="plan-features">
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Unlimited patient records
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Full appointment management
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Basic inventory & services
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Up to 3 staff accounts
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Email support
                    </li>
                </ul>
            </div>

            <!-- PROFESSIONAL (FEATURED) -->
            <div class="plan-card featured">
                <div class="plan-tier-row">
                    <span class="plan-tier">Professional</span>
                    <span class="plan-badge badge-recommended">Recommended</span>
                </div>
                <div class="plan-name">Growing Clinic</div>
                <div class="plan-desc">Unlock advanced tools to manage a growing practice. Trusted by busy dental teams.</div>

                <div class="plan-price-block">
                    <span class="plan-currency">₱</span>
                    <span class="plan-amount" data-monthly="1999" data-annual="1599">1,999</span>
                    <span class="plan-period">/ month</span>
                </div>
                <div class="plan-annual-note" id="note-pro">&nbsp;</div>

                <button type="button" onclick="selectPlan('Growing Clinic', 1999, 1599)" class="plan-btn btn-filled" style="cursor:pointer; width:100%;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    Upgrade to Professional
                </button>

                <div class="plan-divider"></div>
                <div class="plan-features-label">Everything in Starter, and:</div>
                <ul class="plan-features">
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Advanced dental records & history
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Full reports & analytics dashboard
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        SMS / email patient reminders
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Up to 10 staff accounts
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Billing & invoice generation
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Priority email &amp; chat support
                    </li>
                </ul>
            </div>

            <!-- ENTERPRISE -->
            <div class="plan-card">
                <div class="plan-tier-row">
                    <span class="plan-tier">Enterprise</span>
                    <span class="plan-badge badge-enterprise">Multi-Branch</span>
                </div>
                <div class="plan-name">Enterprise</div>
                <div class="plan-desc">For large clinics and multi-branch operations that need maximum power and control.</div>

                <div class="plan-price-block">
                    <span class="plan-currency">₱</span>
                    <span class="plan-amount" data-monthly="4999" data-annual="3999">4,999</span>
                    <span class="plan-period">/ month</span>
                </div>
                <div class="plan-annual-note" id="note-ent">&nbsp;</div>

                <button type="button" onclick="selectPlan('Enterprise', 4999, 3999)" class="plan-btn btn-gold" style="cursor:pointer; width:100%;">
                    Select Enterprise
                </button>


                <div class="plan-divider"></div>
                <div class="plan-features-label">Everything in Professional, and:</div>
                <ul class="plan-features">
                    <li class="highlighted-feat">
                        <span class="feat-icon check-gold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Unlimited staff accounts
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-gold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Multi-branch management
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-gold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Custom role permissions
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-gold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Dedicated account manager
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-gold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        Custom onboarding &amp; training
                    </li>
                    <li class="highlighted-feat">
                        <span class="feat-icon check-gold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        24/7 priority phone support
                    </li>
                </ul>
            </div>

        </div>
    </section>

    <!-- ============================================================
         FOOTER
    ============================================================ -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-section footer-brand">
                <h2>Dental<span>Sync</span> Clinic</h2>
                <p>
                    Modern dental care powered by smart technology. Providing comprehensive, comfortable, and personalized dental services.
                </p>
            </div>

            <div class="footer-section">
                <h3>QUICK LINKS</h3>
                <div class="footer-links-grid">
                    <a asp-controller="LandingPage" asp-action="Promotionpage" asp-fragment="home">Home</a>
                    <a asp-controller="LandingPage" asp-action="Promotionpage" asp-fragment="about">About</a>
                    <a asp-controller="LandingPage" asp-action="Promotionpage" asp-fragment="services">Services</a>
                    <a asp-controller="LandingPage" asp-action="Promotionpage" asp-fragment="dentists">Our Dentists</a>
                    <a asp-controller="LandingPage" asp-action="Promotionpage" asp-fragment="dentalsync">DentalSync</a>
                    <a asp-controller="LandingPage" asp-action="Promotionpage" asp-fragment="contact">Contact</a>
                </div>
            </div>

            <div class="footer-section">
                <h3>CONTACT US</h3>
                <p>📍 Davao City, Philippines</p>
                <p>☎ +63 (082) 221-0190</p>
                <p>✉ dentalsync@gmail.com</p>
            </div>

            <div class="footer-section footer-right">
                <h3>DentalSync</h3>
                <p>© 2026 DentalSync.</p>
                <p>All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        let billing = 'monthly';

        function setBilling(mode) {
            billing = mode;
            document.getElementById('btn-monthly').classList.toggle('active', mode === 'monthly');
            document.getElementById('btn-annual').classList.toggle('active', mode === 'annual');
            document.getElementById('save-badge').style.display = mode === 'annual' ? 'inline-flex' : 'none';

            const amounts = document.querySelectorAll('.plan-amount[data-monthly]');
            amounts.forEach(el => {
                const val = mode === 'annual' ? el.dataset.annual : el.dataset.monthly;
                el.textContent = parseInt(val).toLocaleString();
            });

            const noteBasic = document.getElementById('note-basic');
            const notePro   = document.getElementById('note-pro');
            const noteEnt   = document.getElementById('note-ent');

            if (mode === 'annual') {
                noteBasic.innerHTML = 'Billed as <span class="save-highlight">₱7,668/year</span>';
                notePro.innerHTML   = 'Billed as <span class="save-highlight">₱19,188/year</span>';
                noteEnt.innerHTML   = 'Billed as <span class="save-highlight">₱47,988/year</span>';
            } else {
                noteBasic.innerHTML = '&nbsp;';
                notePro.innerHTML   = '&nbsp;';
                noteEnt.innerHTML   = '&nbsp;';
            }
        }

        function selectPlan(planName, monthlyPrice, annualPrice) {
            const price = billing === 'annual' ? annualPrice : monthlyPrice;
            window.location.href = `/LandingPage/CheckoutPage?plan=${encodeURIComponent(planName)}&billing=${billing}&price=${price}`;
        }
    </script>

</body>
</html>
