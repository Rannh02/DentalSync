@{
    ViewData["Title"] = "DentalSync Clinic - Modern Dental Care";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/PromotionPage.css" asp-append-version="true" />
</head>

<body>

    <!-- =========================
         NAVIGATION
    ========================== -->

    <nav class="navbar">
        <a href="#home" class="logo">
            <span class="logo-text">Dental<span>Sync</span> Clinic</span>
        </a>

        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>

        <div class="nav-links" id="navLinks">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#services">Services</a>
            <a href="#dentists">Our Dentists</a>
            <a href="#dentalsync">DentalSync</a>
            <a href="#contact">Contact</a>

            <div class="nav-buttons">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn-secondary nav-login">
                    Sign In
                </a>
                <a asp-controller="LandingPage" asp-action="SubscriptionPage" class="btn-primary nav-book-btn">
                    Subscribe System
                </a>
            </div>
        </div>
    </nav>


    <!-- =========================
         HERO SECTION
    ========================== -->

    <main style="flex: 1;">
        <section class="hero" id="home">
            <div class="hero-content">
                <span class="hero-badge">
                    <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                    </svg>
                    YOUR SMILE, OUR PRIORITY
                </span>

                <h1>
                    Modern Dental Care,<br />
                    Made for <span>You.</span>
                </h1>

                <p class="hero-description">
                    Experience comfortable, reliable, and personalized dental care with our team of trusted dental professionals.
                </p>

                <div class="hero-buttons">
                    <a href="#appointment" class="btn-primary">
                        Book an Appointment
                    </a>
                    <a href="#services" class="btn-secondary">
                        Explore Our Services
                    </a>
                </div>

                <p class="hero-powered-note">
                    <svg class="note-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 16v-4"></path>
                        <path d="M12 8h.01"></path>
                    </svg>
                    Powered by DentalSync — smart technology for a better clinic experience.
                </p>
            </div>

            <div class="hero-visual">
                <!-- Replace with actual DentalSync Clinic hero image -->
                <div class="hero-image-wrapper">
                    <img src="~/Images/hero-clinic.jpg" alt="Modern Dental Clinic Care" class="hero-img" />
                </div>
            </div>
        </section>


        <!-- =========================
             ABOUT OUR CLINIC
        ========================== -->

        <section class="section" id="about">
            <div class="about">
                <div class="about-visual">
                    <!-- Replace with actual DentalSync Clinic about image -->
                    <div class="about-image-wrapper">
                        <img src="~/Images/about-clinic.jpg" alt="DentalSync Clinic Interior" class="about-img" />
                        <div class="about-experience-badge">
                            <span class="exp-number">10+</span>
                            <span class="exp-text">Years of Excellence</span>
                        </div>
                    </div>
                </div>

                <div class="about-content">
                    <div class="section-label">ABOUT OUR CLINIC</div>
                    <h2>Quality Dental Care with a Modern Approach</h2>
                    <p>
                        DentalSync Clinic is committed to providing professional, comfortable, and patient-centered dental care. Our team combines modern dental practices with smart technology to make every visit easier and more organized.
                    </p>

                    <div class="benefits-grid">
                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="8.5" cy="7" r="4"></circle>
                                    <polyline points="17 11 19 13 23 9"></polyline>
                                </svg>
                            </div>
                            <div>
                                <h3>Professional Care</h3>
                                <p>Experienced dental professionals focused on your oral health.</p>
                            </div>
                        </div>

                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            </div>
                            <div>
                                <h3>Patient-Centered</h3>
                                <p>We make your comfort and satisfaction a priority.</p>
                            </div>
                        </div>

                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </div>
                            <div>
                                <h3>Easy Appointments</h3>
                                <p>Schedule and manage your dental visits conveniently.</p>
                            </div>
                        </div>

                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                    <line x1="8" y1="21" x2="16" y2="21"></line>
                                    <line x1="12" y1="17" x2="12" y2="21"></line>
                                </svg>
                            </div>
                            <div>
                                <h3>Smart Technology</h3>
                                <p>Your dental information is securely organized through DentalSync.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- =========================
             DENTAL SERVICES
        ========================== -->

        <section class="section section-light" id="services">
            <div class="section-header">
                <div class="section-label">OUR DENTAL SERVICES</div>
                <h2>Complete Dental Care for Your Smile</h2>
                <p>
                    From preventive care to restorative and cosmetic treatments, our clinic provides services designed to keep your smile healthy and confident.
                </p>
            </div>

            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                            <path d="M12 6v6l4 2"/>
                        </svg>
                    </div>
                    <h3>General Dentistry</h3>
                    <p>Routine dental examinations and preventive oral care.</p>
                    <a href="#contact" class="service-link">Learn More &rarr;</a>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            <path d="M9 12l2 2 4-4"/>
                        </svg>
                    </div>
                    <h3>Teeth Cleaning</h3>
                    <p>Professional cleaning to help maintain healthy teeth and gums.</p>
                    <a href="#contact" class="service-link">Learn More &rarr;</a>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                        </svg>
                    </div>
                    <h3>Tooth Restoration</h3>
                    <p>Treatment and restoration for damaged or decayed teeth.</p>
                    <a href="#contact" class="service-link">Learn More &rarr;</a>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                    </div>
                    <h3>Cosmetic Dentistry</h3>
                    <p>Enhance the appearance and confidence of your smile.</p>
                    <a href="#contact" class="service-link">Learn More &rarr;</a>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6L6 18M6 6l12 12"/>
                        </svg>
                    </div>
                    <h3>Tooth Extraction</h3>
                    <p>Safe and professional tooth removal when necessary.</p>
                    <a href="#contact" class="service-link">Learn More &rarr;</a>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5z"/>
                        </svg>
                    </div>
                    <h3>Dental Crowns</h3>
                    <p>Restore damaged or weakened teeth with durable dental crowns.</p>
                    <a href="#contact" class="service-link">Learn More &rarr;</a>
                </div>
            </div>
        </section>


        <section class="section" id="why-choose-us">
            <div class="section-header">
                <div class="section-label">WHY CHOOSE US?</div>
                <h2>Care That Puts You First</h2>
                <p>
                    We prioritize your health, comfort, and peace of mind at every step of your dental treatment.
                </p>
            </div>

            <div class="why-grid">
                <div class="why-card">
                    <div class="why-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3>Professional Dental Team</h3>
                    <p>Dedicated dental professionals focused on quality care.</p>
                </div>

                <div class="why-card">
                    <div class="why-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </div>
                    <h3>Comfortable Environment</h3>
                    <p>A welcoming and comfortable environment for every patient.</p>
                </div>

                <div class="why-card">
                    <div class="why-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <h3>Convenient Scheduling</h3>
                    <p>Easy appointment scheduling and organized visits.</p>
                </div>

                <div class="why-card">
                    <div class="why-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                            <rect x="9" y="9" width="6" height="6"></rect>
                            <line x1="9" y1="1" x2="9" y2="4"></line>
                            <line x1="15" y1="1" x2="15" y2="4"></line>
                            <line x1="9" y1="20" x2="9" y2="23"></line>
                            <line x1="15" y1="20" x2="15" y2="23"></line>
                            <line x1="20" y1="9" x2="23" y2="9"></line>
                            <line x1="20" y1="15" x2="23" y2="15"></line>
                            <line x1="1" y1="9" x2="4" y2="9"></line>
                            <line x1="1" y1="15" x2="4" y2="15"></line>
                        </svg>
                    </div>
                    <h3>Modern Technology</h3>
                    <p>Smart technology helps us manage your care efficiently.</p>
                </div>
            </div>
        </section>


        <!-- =========================
             OUR DENTISTS
        ========================== -->

        <section class="section section-light" id="dentists">
            <div class="section-header">
                <div class="section-label">MEET OUR DENTISTS</div>
                <h2>Our Dental Professionals</h2>
                <p>
                    Meet our team of licensed and compassionate dental experts dedicated to your healthiest smile.
                </p>
            </div>

            <div class="dentists-grid">
                <!-- Replace with actual dentist photo -->
                <div class="dentist-card">
                    <div class="dentist-image-container">
                        <img src="~/Images/dentist-1.jpg" alt="Dr. Maria Santos" class="dentist-img" />
                    </div>
                    <div class="dentist-info">
                        <h3>Dr. Maria Santos</h3>
                        <span class="dentist-spec">General Dentist</span>
                        <p>
                            Specializing in preventive dentistry and comprehensive oral exams with over 10 years of clinical experience.
                        </p>
                        <a href="#contact" class="btn-dentist">View Profile</a>
                    </div>
                </div>

                <!-- Replace with actual dentist photo -->
                <div class="dentist-card">
                    <div class="dentist-image-container">
                        <img src="~/Images/dentist-2.jpg" alt="Dr. John Reyes" class="dentist-img" />
                    </div>
                    <div class="dentist-info">
                        <h3>Dr. John Reyes</h3>
                        <span class="dentist-spec">Restorative Dentist</span>
                        <p>
                            Expert in restorative procedures, root canals, and advanced dental crowns to restore function and confidence.
                        </p>
                        <a href="#contact" class="btn-dentist">View Profile</a>
                    </div>
                </div>

                <!-- Replace with actual dentist photo -->
                <div class="dentist-card">
                    <div class="dentist-image-container">
                        <img src="~/Images/dentist-3.jpg" alt="Dr. Angela Cruz" class="dentist-img" />
                    </div>
                    <div class="dentist-info">
                        <h3>Dr. Angela Cruz</h3>
                        <span class="dentist-spec">Cosmetic Dentist</span>
                        <p>
                            Dedicated to aesthetic transformations, teeth whitening, veneers, and creating radiant patient smiles.
                        </p>
                        <a href="#contact" class="btn-dentist">View Profile</a>
                    </div>
                </div>
            </div>
        </section>


        <!-- =========================
             POWERED BY DENTALSYNC
        ========================== -->

        <section class="section dentalsync-section" id="dentalsync">
            <div class="dentalsync-grid">
                <div class="dentalsync-visual">
                    <div class="dashboard-card">
                        <div class="dashboard-header">
                            <div class="dashboard-title">
                                Clinic Management System Overview
                            </div>
                            <span class="live-badge">Live System</span>
                        </div>
                        <div class="dashboard-stats">
                            <div class="stat">
                                <span class="stat-number">200+</span>
                                <span class="stat-label">Active Patients</span>
                            </div>
                            <div class="stat">
                                <span class="stat-number">24</span>
                                <span class="stat-label">Daily Appointments</span>
                            </div>
                            <div class="stat">
                                <span class="stat-number">3</span>
                                <span class="stat-label">Staff Dentists</span>
                            </div>
                        </div>

                        <div class="appointment">
                            <div class="patient">
                                <div class="patient-avatar">JR</div>
                                <div>
                                    <div class="patient-name">José Rizal</div>
                                    <div class="patient-service">Dental Cleaning</div>
                                </div>
                            </div>
                            <span class="status-pill status-confirmed">Confirmed</span>
                        </div>

                        <div class="appointment">
                            <div class="patient">
                                <div class="patient-avatar">JL</div>
                                <div>
                                    <div class="patient-name">Juan Luna</div>
                                    <div class="patient-service">Dental Checkup</div>
                                </div>
                            </div>
                            <span class="status-pill status-in-progress">In Progress</span>
                        </div>
                    </div>
                </div>

                <div class="dentalsync-content">
                    <div class="section-label">POWERED BY DENTALSYNC</div>
                    <h2>Better Dental Care Through Smart Technology</h2>
                    <p>
                        Behind every great patient experience is an organized clinic. DentalSync is our integrated ERP & CRM platform designed to help our clinic efficiently manage patients, appointments, dental records, billing, inventory, and reports.
                    </p>

                    <ul class="check-list">
                        <li>Patient & Dentist Management</li>
                        <li>Appointment Scheduling & Reminders</li>
                        <li>Dental Treatment Records</li>
                        <li>Billing & Payment Tracking</li>
                        <li>Dental Supply Inventory</li>
                        <li>Reports & Analytics</li>
                    </ul>

                    <div class="dentalsync-action">
                        <a asp-controller="Account" asp-action="Login" class="btn-primary">
                            Learn About DentalSync
                        </a>
                    </div>
                </div>
            </div>
        </section>


        <!-- =========================
             APPOINTMENT CTA
        ========================== -->

        <section class="appointment-cta" id="appointment">
            <div class="appointment-cta-box">
                <h2>Your Smile Starts Here.</h2>
                <p>
                    Message us for inquiries and concerns!
                </p>
                <a href="#contact" class="btn-primary btn-cta">
                    Contact Us!
                </a>
            </div>
        </section>


        <!-- =========================
             CONTACT SECTION
        ========================== -->

        <section class="contact-section" id="contact">
            <div class="contact-container">

                <div class="contact-header">
                    <div class="section-label">CONTACT OUR CLINIC</div>
                    <h2>Get in Touch With DentalSync Clinic</h2>
                    <p>
                        Have questions, need assistance, or want to schedule a visit? Send us a message and our team will be happy to help.
                    </p>
                </div>

                <div class="contact-grid">
                    <div class="contact-info-card">
                        <h3>Clinic Information</h3>
                        <p class="info-intro">Visit our office or reach out through any of our channels below.</p>

                        <div class="contact-info-item">
                            <div class="info-icon">📍</div>
                            <div>
                                <strong>Location</strong>
                                <p>Davao City, Philippines</p>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="info-icon">☎</div>
                            <div>
                                <strong>Phone</strong>
                                <p>+63 (082) 221-0190</p>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="info-icon">✉</div>
                            <div>
                                <strong>Email</strong>
                                <p>dentalsync@gmail.com</p>
                            </div>
                        </div>

                        <div class="clinic-hours">
                            <strong>Clinic Hours:</strong>
                            <p>Mon - Sat: 8:00 AM - 5:00 PM</p>
                            <p>Sunday: Closed</p>
                        </div>
                    </div>

                    <form class="contact-form">
                        <div class="form-group">
                            <label for="name">Name</label>
                            <input type="text"
                                   id="name"
                                   name="name"
                                   placeholder="Your Full Name"
                                   required>
                        </div>

                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   placeholder="Email Address"
                                   required>
                        </div>

                        <div class="form-group">
                            <label for="phone">Phone Number</label>
                            <input type="tel"
                                   id="phone"
                                   name="phone"
                                   placeholder="Phone Number"
                                   required>
                        </div>

                        <div class="form-group">
                            <label for="preferred-date">Preferred Appointment Date (Optional)</label>
                            <input type="date"
                                   id="preferred-date"
                                   name="preferred-date">
                        </div>

                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea id="message"
                                      name="message"
                                      rows="4"
                                      placeholder="Write your message or requested dental service..."
                                      required></textarea>
                        </div>

                        <button type="submit" class="contact-btn">
                            Send Message
                        </button>
                    </form>
                </div>

            </div>
        </section>
    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-section footer-brand">
                <h2>Dental<span>Sync</span> Clinic</h2>
                <p>
                    Modern dental care powered by smart technology. Providing comprehensive, comfortable, and personalized dental services.
                </p>
            </div>

            <div class="footer-section">
                <h3>QUICK LINKS</h3>
                <div class="footer-links-grid">
                    <a href="#home">Home</a>
                    <a href="#about">About</a>
                    <a href="#services">Services</a>
                    <a href="#dentists">Our Dentists</a>
                    <a href="#dentalsync">DentalSync</a>
                    <a href="#contact">Contact</a>
                </div>
            </div>

            <div class="footer-section">
                <h3>CONTACT US</h3>
                <p>📍 Davao City, Philippines</p>
                <p>☎ +63 (082) 221-0190</p>
                <p>✉ dentalsync@gmail.com</p>
            </div>

            <div class="footer-section footer-right">
                <h3>DentalSync</h3>
                <p>© 2026 DentalSync.</p>
                <p>All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Mobile Navigation Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const navToggle = document.getElementById('navToggle');
            const navLinks = document.getElementById('navLinks');

            if (navToggle && navLinks) {
                navToggle.addEventListener('click', function () {
                    navLinks.classList.toggle('active');
                    navToggle.classList.toggle('active');
                });

                // Close menu when clicking a link
                const links = navLinks.querySelectorAll('a');
                links.forEach(link => {
                    link.addEventListener('click', function () {
                        navLinks.classList.remove('active');
                        navToggle.classList.remove('active');
                    });
                });
            }
        });
    </script>
</body>
</html>