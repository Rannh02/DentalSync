@model DentalSync.ViewModels.ResetUserPasswordViewModel
@{ Layout = null; }

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/users.css" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Sidebar.cshtml")
    <main class="users-page">

        <a asp-controller="Users" asp-action="Users" class="back-link">
            ← Back to Users
        </a>

        <div class="users-page-heading">
            <div>
                <h1>Reset Password</h1>
                <p>Set a new password for <strong>@Model.UserName</strong>.</p>
            </div>
        </div>

        <section class="users-panel user-form-card" aria-label="Reset password form">
            <form method="post"
                  asp-controller="Users"
                  asp-action="ResetUserPassword"
                  autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserName" />

                <div asp-validation-summary="All" class="modal-error" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="modal-section-title">New Credentials</div>

                <label>Account</label>
                <input type="text"
                       value="@Model.UserName"
                       disabled
                       style="background:#f8fafc; color:#64748b;" />

                <label for="resetNewPassword">New Password</label>
                <input id="resetNewPassword"
                       asp-for="NewPassword"
                       type="password"
                       required
                       autocomplete="new-password"
                       placeholder="Minimum 8 characters" />
                <span asp-validation-for="NewPassword" class="field-error"></span>

                <label for="resetConfirmPassword">Confirm New Password</label>
                <input id="resetConfirmPassword"
                       asp-for="ConfirmPassword"
                       type="password"
                       required
                       autocomplete="new-password"
                       placeholder="Re-enter new password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>

                <div class="password-strength" aria-live="polite" style="margin-top:6px;">
                    <div class="password-strength-track">
                        <span id="resetPasswordStrengthBar"></span>
                    </div>
                    <strong id="resetPasswordStrengthLabel">Enter a password</strong>
                </div>
                <small class="password-requirements">
                    At least 8 characters. Strong passwords include uppercase, lowercase, numbers and special characters.
                </small>

                <div class="user-modal-actions" style="margin-top:24px;">
                    <a asp-controller="Users"
                       asp-action="Users"
                       class="users-clear-button">Cancel</a>
                    <button type="submit" class="users-filter-button">Reset Password</button>
                </div>
            </form>
        </section>

    </main>
</div>

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Footer.cshtml")

<script>
    (function () {
        const input = document.getElementById('resetNewPassword');
        const bar = document.getElementById('resetPasswordStrengthBar');
        const label = document.getElementById('resetPasswordStrengthLabel');

        if (!input || !bar || !label) return;

        input.addEventListener('input', function () {
            const val = this.value;
            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^a-zA-Z0-9]/.test(val)) score++;

            const levels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
            const colors = ['', '#ef4444', '#f59e0b', '#3b82f6', '#22c55e'];
            const widths = ['0%', '25%', '50%', '75%', '100%'];

            bar.style.width = widths[score] || '0%';
            bar.style.background = colors[score] || '';
            label.textContent = val.length === 0 ? 'Enter a password' : (levels[score] || '');
        });
    })();
</script>
