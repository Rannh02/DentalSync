@{
    Layout = null;
    ViewData["Title"] = "Patient Dashboard";
}

@await Html.PartialAsync("~/Views/Shared/PatientSideBar/_HeaderPatient.cshtml")
<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/receptionist.css" asp-append-version="true" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/PatientSideBar/_SidebarPatient.cshtml")

    <main class="receptionist-page">
        <div class="page-header">
            <div>
                <h1>Patient Dashboard</h1>
                <p>Welcome back to DentalSync. Access your appointments, bills, and treatments below.</p>
            </div>
        </div>

        <div class="dashboard-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 24px;">
            <!-- Request Appointment Card -->
            <div class="layout-card" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%; min-height: 180px; padding: 24px; border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s; cursor: pointer;" onclick="location.href='/Patient/RequestAppointment'">
                <div>
                    <div style="background: #eef2ff; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 8px; margin-bottom: 16px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </div>
                    <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 8px; color: #0b1220;">Request Appointment</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.5; margin: 0;">Schedule a new dental visit with your preferred dentist and date.</p>
                </div>
                <div style="margin-top: 16px; font-size: 14px; font-weight: 600; color: #4f46e5; display: flex; align-items: center; gap: 4px;">
                    Book now &rarr;
                </div>
            </div>

            <!-- View Billing & Payments Card -->
            <div class="layout-card" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%; min-height: 180px; padding: 24px; border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s; cursor: pointer;" onclick="location.href='/Patient/ViewBillingPayments'">
                <div>
                    <div style="background: #ecfdf5; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 8px; margin-bottom: 16px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                    <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 8px; color: #0b1220;">Billing & Payments</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.5; margin: 0;">Track invoices, view outstanding balances, and check transaction history.</p>
                </div>
                <div style="margin-top: 16px; font-size: 14px; font-weight: 600; color: #10b981; display: flex; align-items: center; gap: 4px;">
                    View bills &rarr;
                </div>
            </div>

            <!-- View Treatment Transactions Card -->
            <div class="layout-card" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%; min-height: 180px; padding: 24px; border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s; cursor: pointer;" onclick="location.href='/Patient/ViewTreatmentTransaction'">
                <div>
                    <div style="background: #fdf2f8; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 8px; margin-bottom: 16px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14v16H5z" stroke-width="2"/><path d="M9 8h6M9 12h6M9 16h4" stroke-width="2" stroke-linecap="round"/></svg>
                    </div>
                    <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 8px; color: #0b1220;">Treatment History</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.5; margin: 0;">Review your complete record of dental treatments and procedures.</p>
                </div>
                <div style="margin-top: 16px; font-size: 14px; font-weight: 600; color: #ec4899; display: flex; align-items: center; gap: 4px;">
                    View procedures &rarr;
                </div>
            </div>
        </div>
    </main>
</div>
