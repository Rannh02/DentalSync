@model DentalSync.ViewModels.RequestAppointmentViewModel
@{
    Layout = null;
    ViewData["Title"] = "Request Appointment";
}

@await Html.PartialAsync("~/Views/Shared/PatientSideBar/_HeaderPatient.cshtml")
<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/receptionist.css" asp-append-version="true" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/PatientSideBar/_SidebarPatient.cshtml")

    <main class="receptionist-page">
        <div class="page-header">
            <div>
                <h1>Request Appointment</h1>
                <p>Schedule a new dental appointment with your preferred date and dentist.</p>
            </div>
        </div>

        @if (TempData["PatientSuccess"] != null)
        {
            <div class="alert-banner alert-success">
                @TempData["PatientSuccess"]
            </div>
        }

        <!-- My Requested Appointments Table -->
        <div class="layout-card">
            <div class="ds-table-responsive">
                <table class="ds-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Dentist</th>
                            <th>Service</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MyAppointments.Count == 0)
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; color: #94a3b8; padding: 32px;">
                                    No appointment requests yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var app in Model.MyAppointments)
                            {
                                <tr>
                                    <td style="font-weight: 500;">@app.AppointmentDate.ToString("MMMM dd, yyyy")</td>
                                    <td>@app.StartTime.ToString("hh:mm tt")</td>
                                    <td style="font-weight: 600; color: #1e293b;">@app.PatientName</td>
                                    <td>@app.DentistName</td>
                                    <td>
                                        <span style="font-weight: 500; color: #4f46e5;">@app.ServiceNames</span>
                                        @if (app.TotalCost > 0)
                                        {
                                            <br /><small style="color:#64748b; font-size:11px; font-weight:600;">₱@app.TotalCost.ToString("N2")</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="ds-badge ds-badge-@app.Status.ToLower()">@app.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>
