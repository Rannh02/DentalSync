@model DentalSync.ViewModels.StockTransactionsViewModel
@{
    Layout = null;
    ViewData["Title"] = "Stock Transactions";
}

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Header.cshtml")
<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Sidebar.cshtml")

    <main class="inventory-page">
        <!-- Heading -->
        <div class="inventory-page-heading">
            <div>
                <h1>Stock Transactions</h1>
                <p>Complete audit history of stock-in, stock-out, and inventory movements.</p>
            </div>
            <div class="inventory-heading-actions">
                <a asp-controller="Inventory" asp-action="DentalSupplies" class="inv-btn inv-btn-primary">
                    &larr; View Dental Supplies
                </a>
            </div>
        </div>

        <!-- Panel with Search & Filters -->
        <section class="inv-panel" aria-label="Stock Movement History">
            <form method="get" asp-controller="Inventory" asp-action="Stocks" class="inv-filters">
                <!-- Search -->
                <label class="inv-search">
                    <span class="sr-only">Search transactions</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                    <input type="search" name="search" value="@Model.Search" placeholder="Search reference, notes, or supply..." />
                </label>

                <!-- Type Filter -->
                <label>
                    <span class="sr-only">Type</span>
                    <select name="type">
                        <option value="all">All Movement Types</option>
                        <option value="In" selected="@(Model.Type == "In")">Stock In (+)</option>
                        <option value="Out" selected="@(Model.Type == "Out")">Stock Out (-)</option>
                        <option value="Adjustment" selected="@(Model.Type == "Adjustment")">Adjustment (~)</option>
                    </select>
                </label>

                <!-- Supply Filter -->
                <label>
                    <span class="sr-only">Supply</span>
                    <select name="supplyId">
                        <option value="">All Supplies</option>
                        @foreach (var sup in Model.Supplies)
                        {
                            <option value="@sup.Id" selected="@(Model.SupplyId == sup.Id)">@sup.SupplyName</option>
                        }
                    </select>
                </label>

                <!-- Date Filter -->
                <label>
                    <span class="sr-only">Date</span>
                    <input type="date" name="date" value="@Model.Date" title="Filter by Transaction Date" />
                </label>

                <button type="submit" class="inv-filter-btn">Filter</button>
                @if (!string.IsNullOrEmpty(Model.Search) || (!string.IsNullOrEmpty(Model.Type) && Model.Type != "all") || Model.SupplyId.HasValue || !string.IsNullOrEmpty(Model.Date))
                {
                    <a asp-controller="Inventory" asp-action="Stocks" class="inv-clear-btn">Clear</a>
                }
            </form>

            <!-- Table: Date | Supply | Type | Quantity | User -->
            <div class="inv-table-wrap">
                <table class="inv-table">
                    <colgroup>
                        <col style="width: 20%;" />
                        <col style="width: 32%;" />
                        <col style="width: 14%;" />
                        <col style="width: 14%;" />
                        <col style="width: 20%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Supply</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions.Count == 0)
                        {
                            <tr>
                                <td colspan="5" style="padding: 48px; text-align: center; color: #64748b;">
                                    No stock transaction records match the selected filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Transactions)
                            {
                                <tr>
                                    <!-- Date -->
                                    <td>
                                        <strong style="color: #0f172a; font-size: 13px;">@item.Date.ToLocalTime().ToString("MMM dd, yyyy")</strong>
                                        <small style="display: block; color: #64748b; font-size: 11px;">@item.Date.ToLocalTime().ToString("hh:mm tt")</small>
                                    </td>

                                    <!-- Supply -->
                                    <td class="supply-name-cell">
                                        <strong>@item.SupplyName</strong>
                                        <span class="category-tag" style="margin-top: 2px;">@item.CategoryName</span>
                                    </td>

                                    <!-- Type -->
                                    <td>
                                        @if (item.Type == "In")
                                        {
                                            <span class="type-pill type-in">+ Stock In</span>
                                        }
                                        else if (item.Type == "Out")
                                        {
                                            <span class="type-pill type-out">- Stock Out</span>
                                        }
                                        else
                                        {
                                            <span class="type-pill type-adj">~ @item.Type</span>
                                        }
                                    </td>

                                    <!-- Quantity -->
                                    <td>
                                        @if (item.Type == "In")
                                        {
                                            <strong style="color: #158a3e; font-size: 14px;">+@item.Quantity</strong>
                                        }
                                        else if (item.Type == "Out")
                                        {
                                            <strong style="color: #c22a2a; font-size: 14px;">-@item.Quantity</strong>
                                        }
                                        else
                                        {
                                            <strong style="color: #6d28d9; font-size: 14px;">@item.Quantity</strong>
                                        }
                                        <span style="color: #64748b; font-size: 12px; margin-left: 3px;">@item.Unit</span>
                                    </td>

                                    <!-- User & Notes -->
                                    <td>
                                        <div style="font-size: 13px; font-weight: 600; color: #1e293b;">@item.UserName</div>
                                        @if (!string.IsNullOrEmpty(item.Reference) || !string.IsNullOrEmpty(item.Notes))
                                        {
                                            <small style="color: #64748b; font-size: 11px; display: block;">
                                                @(string.IsNullOrEmpty(item.Reference) ? "" : $"[{item.Reference}] ")
                                                @(item.Notes ?? "")
                                            </small>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="inv-pagination" aria-label="Transactions pagination">
                    <span>Showing @((Model.Page - 1) * Model.PageSize + (Model.TotalCount == 0 ? 0 : 1))-@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount transactions</span>
                    <div>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <a class="@(p == Model.Page ? "current" : "")"
                               asp-controller="Inventory"
                               asp-action="Stocks"
                               asp-route-search="@Model.Search"
                               asp-route-type="@Model.Type"
                               asp-route-supplyId="@Model.SupplyId"
                               asp-route-date="@Model.Date"
                               asp-route-page="@p">@p</a>
                        }
                    </div>
                </nav>
            }
        </section>
    </main>
</div>

@await Html.PartialAsync("~/Views/Shared/AdministratorBars/_Footer.cshtml")
