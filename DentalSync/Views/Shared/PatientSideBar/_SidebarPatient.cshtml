@{
    var ctrl   = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString()     ?? "";

    string ActiveIf(string c, string a) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(action, a, StringComparison.OrdinalIgnoreCase)
            ? " active" : "";
}

<aside class="ds-sidebar">
    <nav aria-label="Patient Portal Navigation" class="ds-nav">
        <ul class="ds-list">
            <li class="ds-item">
                <a asp-controller="Patient" asp-action="Dashboard" class="ds-link@(ActiveIf("Patient","Dashboard"))">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="8" height="8" rx="1" stroke="#0b1220" stroke-width="1.5" /><rect x="13" y="3" width="8" height="8" rx="1" stroke="#0b1220" stroke-width="1.5" /><rect x="3" y="13" width="8" height="8" rx="1" stroke="#0b1220" stroke-width="1.5" /><rect x="13" y="13" width="8" height="8" rx="1" stroke="#0b1220" stroke-width="1.5" /></svg>
                    <span>Dashboard</span>
                </a>
            </li>
        </ul>


        <div class="ds-section-title">APPOINTMENTS</div>
        <ul class="ds-list">
            <li class="ds-item"><a asp-controller="Patient" asp-action="RequestAppointment" class="ds-link@(ActiveIf("Patient","RequestAppointment"))"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>Request Appointment</a></li>
        </ul>

        <div class="ds-section-title">BILLING</div>
        <ul class="ds-list">
            <li class="ds-item"><a asp-controller="Patient" asp-action="ViewBillingPayments" class="ds-link@(ActiveIf("Patient","ViewBillingPayments"))"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>View Billing & Payments</a></li>
            <li class="ds-item"><a asp-controller="Patient" asp-action="ViewTreatmentTransaction" class="ds-link@(ActiveIf("Patient","ViewTreatmentTransaction"))"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 4h14v16H5z" stroke="#222" stroke-width="1.2"/><path d="M8 8h8M8 12h8M8 16h5" stroke="#222" stroke-width="1.2" stroke-linecap="round"/></svg>View Treatment Transactions</a></li>
        </ul>

        <div class="ds-section-title">NOTIFICATIONS</div>
        <ul class="ds-list">
            <li class="ds-item"><a asp-controller="Patient" asp-action="ReceiveReminders" class="ds-link@(ActiveIf("Patient","ReceiveReminders"))"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 17H9a3 3 0 0 0 6 0z" fill="none"/><path d="M18 8a6 6 0 1 0-12 0c0 7-3 7-3 7h18s-3 0-3-7z" fill="none"/></svg>Receive Reminders</a></li>
        </ul>
    </nav>
</aside>
