<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
    content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <script type="importmap"></script>
    <link rel="stylesheet"href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"href="~/css/Account.css"asp-append-version="true" />
</head>

<body>
    
    <main class="main-content">

        <div class="video-container">
            <div class="video-content">

                <div class="video-text">
                    <h1 class="account-brand-title">Dental<span class="account-brand-accent">Sync</span></h1>
                    <p>Best Dental Clinic in the Universe</p>
                </div>

                <div class="video-wrapper">
                    <video autoplay muted loop playsinline controls>
                        <source src="~/css/PromotionalVideos/Promotion-Vid.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>

                <div class="info-cards">

                    <a asp-controller="Home" asp-action="Promotionpage" class="info-card">
                        <div class="info-card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <div class="info-card-body">
                            <strong>Our Pages</strong>
                            <span>Visit our pages for more information about our clinic.</span>
                        </div>
                        <div class="info-card-arrow">›</div>
                    </a>
                </div>
            </div>
        </div>
        <div class="login-container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-section footer-brand">
                <h2>
                    Dental<span>Sync</span>
                </h2>
                <p>
                    DentalSync is a dental clinic management system
                    designed to streamline clinic operations
                    and patient care.
                </p>
            </div>
            <div class="footer-section">
                <h3>CONTACT US</h3>
                <p>📍 Davao City, Philippines</p>
                <p>☎ +63 (082) 221-0190</p>
                <p>✉ dentalsync@gmail.com</p>
            </div>
            <div class="footer-section footer-right">
                <h3>DentalSync</h3>
                <p> © 2026 DentalSync.</p>
                <p>All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>