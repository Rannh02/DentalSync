@model DentalSync.ViewModels.DentistPatientRecordsViewModel
@{
    Layout = null;
    ViewData["Title"] = "Patient Records";
}

@await Html.PartialAsync("~/Views/Shared/DentistSideBars/_HeaderDentist.cshtml")
<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/receptionist.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/DentistSideBars/_SidebarDentist.cshtml")

    <main class="receptionist-page">
        <div class="page-header">
            <div>
                <h1>Patient Records</h1>
                <p>View the appointment and procedure records assigned to you.</p>
            </div>
            <div>
                <span class="users-total">@Model.TotalRecords records</span>
            </div>
        </div>

        @if (TempData["PatientRecordSuccess"] != null)
        {
            <div class="alert-banner alert-success">@TempData["PatientRecordSuccess"]</div>
        }

        <div class="layout-card">
            <form method="get" asp-controller="Dentist" asp-action="ViewPatientRecords" class="users-filters">
                <label class="users-search">
                    <span class="sr-only">Search patient records</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                    <input type="search" name="search" value="@Model.Search" placeholder="Search by patient or service" />
                </label>
                <label>
                    <span class="sr-only">Filter by status</span>
                    <select name="statusFilter">
                        <option value="">All statuses</option>
                        @foreach (var status in new[] { "Scheduled", "Confirmed", "Completed", "Cancelled", "NoShow" })
                        {
                            <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                        }
                    </select>
                </label>
                <button type="submit" class="users-filter-button">Apply filters</button>
                <a asp-controller="Dentist" asp-action="ViewPatientRecords" class="users-clear-button">Clear</a>
            </form>

            <div class="ds-table-responsive">
                <table class="ds-table patient-records-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Dentist</th>
                            <th>Service</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Records.Any())
                        {
                            <tr>
                                <td colspan="7" style="text-align: center; color: #94a3b8; padding: 32px;">No patient records found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var record in Model.Records)
                            {
                                <tr>
                                    <td style="font-weight: 500;">@record.AppointmentDate.ToString("MMMM dd, yyyy")</td>
                                    <td>@record.StartTime.ToString("hh:mm tt")</td>
                                    <td style="font-weight: 600; color: #1e293b;">@record.PatientName</td>
                                    <td>@record.DentistName</td>
                                    <td>@record.ServiceName</td>
                                    <td><span class="ds-badge ds-badge-@record.Status.ToLowerInvariant()">@record.Status</span></td>
                                    <td class="patient-record-actions-cell">
                                        <div class="user-actions patient-record-actions">
                                            <a asp-controller="Dentist" asp-action="ViewPatientRecord" asp-route-id="@record.AppointmentId" class="action-button action-view">View</a>
                                            <form asp-controller="Dentist" asp-action="ArchivePatientRecord" asp-route-id="@record.AppointmentId" method="post" onsubmit="return confirm('Archive this patient record?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-button action-delete">Archive</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="users-pagination" aria-label="Patient records pages">
                    <span>Showing @((Model.Page - 1) * Model.PageSize + (Model.TotalRecords == 0 ? 0 : 1))-@Math.Min(Model.Page * Model.PageSize, Model.TotalRecords) of @Model.TotalRecords</span>
                    <div>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <a class="@(p == Model.Page ? "current" : "")" asp-controller="Dentist" asp-action="ViewPatientRecords" asp-route-search="@Model.Search" asp-route-statusFilter="@Model.StatusFilter" asp-route-page="@p">@p</a>
                    }
                    </div>
                </nav>
            }
        </div>
    </main>
</div>
