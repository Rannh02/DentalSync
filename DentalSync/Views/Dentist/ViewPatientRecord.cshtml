@model DentalSync.ViewModels.DentistPatientRecordItemViewModel
@{
    Layout = null;
    ViewData["Title"] = "Patient Record";
}

@await Html.PartialAsync("~/Views/Shared/DentistSideBars/_HeaderDentist.cshtml")
<link rel="stylesheet" href="~/css/dashboard.css" />
<link rel="stylesheet" href="~/css/receptionist.css" asp-append-version="true" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/DentistSideBars/_SidebarDentist.cshtml")
    <main class="receptionist-page">
        <div class="page-header">
            <div>
                <h1>Patient Record</h1>
                <p>Appointment and procedure details.</p>
            </div>
            <a asp-controller="Dentist" asp-action="ViewPatientRecords" class="btn-secondary" style="text-decoration: none;">Back to records</a>
        </div>

        <div class="layout-card" style="padding: 24px;">
            <dl style="display: grid; grid-template-columns: 160px 1fr; gap: 14px; margin: 0;">
                <dt>Patient</dt><dd>@Model.PatientName</dd>
                <dt>Date</dt><dd>@Model.AppointmentDate.ToString("MMMM dd, yyyy")</dd>
                <dt>Time</dt><dd>@Model.StartTime.ToString("hh:mm tt")</dd>
                <dt>Dentist</dt><dd>@Model.DentistName</dd>
                <dt>Service</dt><dd>@Model.ServiceName</dd>
                <dt>Status</dt><dd>@Model.Status</dd>
                <dt>Notes</dt><dd>@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes recorded." : Model.Notes)</dd>
            </dl>
        </div>
    </main>
</div>