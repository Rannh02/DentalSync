@using DentalSync.ViewModels;
@model VerifyEmailViewModel;

@{
    ViewData["Title"] = "Verify Email";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <div class="account-brand">
            <h1 class="account-brand-title">Dental<span class="account-brand-accent">Sync</span></h1>
            <p class="account-subtitle">Enter your email to reset your password</p>
        </div>

        <form asp-action="VerifyEmail" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
           
            <button type="submit" class="account-btn-primary">Verify Email</button>

            <div class="text-center">
                <a asp-controller="Account" asp-action="Login" class="account-back-link">
                    &larr; Back to Login
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
