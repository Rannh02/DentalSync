@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm mx-auto p-4" style="max-width: 500px;">
        <h2 class="text-danger mb-3">Access Denied</h2>
        <p class="text-muted mb-4">You do not have permission to access this resource. Please make sure you are logged in with an Administrator account.</p>
        <div>
            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-primary">Go to Dashboard</a>
        </div>
    </div>
</div>
