@using DentalSync.ViewModels;
@model LoginViewModel;

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <div class="account-brand">
            <h1 class="account-brand-title">Welcome Back</h1>
            <p class="account-subtitle">Sign in to access your clinic portal</p>
        </div>

        @if (TempData["RegisterSuccess"] as string == "true")
        {
            <div style="background:#dcfce7;border:1px solid #86efac;border-radius:8px;padding:14px;font-size:13px;color:#166534;margin-bottom:18px;">
                ✅ <strong>Account created successfully!</strong> Your admin account is ready. Please sign in below.
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label mb-0">Password</label>
                    <a asp-controller="Account" asp-action="VerifyEmail" class="account-link">
                        Forgot password?
                    </a>
                </div>
                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                <label class="form-check-label" for="rememberMeCheck">
                    @Html.DisplayNameFor(a => a.RememberMe)
                </label>
            </div>

            <button type="submit" class="account-btn-primary">Sign In</button>

            
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
