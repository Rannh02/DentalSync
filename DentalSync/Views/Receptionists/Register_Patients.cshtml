@model DentalSync.ViewModels.PatientManagementViewModel
@{
    Layout = null;
}

@await Html.PartialAsync("~/Views/Shared/ReceptionistBars/_HeaderReceptionist.cshtml")
<link rel="stylesheet" href="~/css/users.css" />

<div class="dashboard-root">
    @await Html.PartialAsync("~/Views/Shared/ReceptionistBars/_SidebarReceptionist.cshtml")
    <main class="users-page">
        <div class="users-page-heading">
            <div>
                <h1>Register Patients</h1>
                <p>Manage and register patient records.</p>
            </div>
            <div class="users-heading-actions">
                <span class="users-total">@Model.TotalPatients patients</span>
                <button type="button" class="users-add-button" id="openCreatePatient">+ Add patient</button>
            </div>
        </div>

        @if (TempData["PatientSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="modal-success" style="margin-bottom: 16px; padding: 12px 16px; border-radius: 8px; background: #e9f9ee; color: #158a3e; font-size: 13px; font-weight: 500;">
                @successMessage
            </div>
        }

        <section class="users-panel" aria-label="Patient management">
            <form method="get" asp-controller="Receptionist" asp-action="Register_Patients" class="users-filters">
                <label class="users-search">
                    <span class="sr-only">Search patients</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                    <input type="search" name="search" value="@Model.Search" placeholder="Search by name, contact, or address" />
                </label>
                <button type="submit" class="users-filter-button">Apply filters</button>
                <a asp-controller="Receptionist" asp-action="Register_Patients" class="users-clear-button">Clear</a>
            </form>

            <div class="users-table-wrap">
                <table class="users-table">
                    <colgroup>
                        <col style="width: 24%;" />
                        <col style="width: 18%;" />
                        <col style="width: 26%;" />
                        <col style="width: 16%;" />
                        <col style="width: 16%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Patient Name</th>
                            <th>Contact Number</th>
                            <th>Address</th>
                            <th>Registered Date</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Patients.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="users-empty">No patients registered yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <span class="user-avatar">@GetInitials(patient.FullName)</span>
                                        <span>
                                            <strong>@patient.FullName</strong>
                                            @if (!string.IsNullOrWhiteSpace(patient.Suffix))
                                            {
                                                <small>Suffix: @patient.Suffix</small>
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td>@patient.ContactNumber</td>
                                <td>@patient.Address</td>
                                <td>@patient.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                <td style="text-align: center;">
                                    <button type="button" class="btn-reminder" onclick="openSendReminderModal(@patient.Id, '@Html.Raw(patient.FullName.Replace("'", "\\'"))')" title="Send Reminder to @patient.FullName">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                        </svg>
                                        <span>Reminder</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="users-pagination" aria-label="Patients pages">
                    <span>Showing @((Model.Page - 1) * Model.PageSize + (Model.TotalPatients == 0 ? 0 : 1))-@Math.Min(Model.Page * Model.PageSize, Model.TotalPatients) of @Model.TotalPatients</span>
                    <div>
                    @for (var page = 1; page <= Model.TotalPages; page++)
                    {
                        <a class="@(page == Model.Page ? "current" : "")" asp-controller="Receptionist" asp-action="Register_Patients" asp-route-search="@Model.Search" asp-route-page="@(page)">@(page)</a>
                    }
                    </div>
                </nav>
            }
        </section>
    </main>
</div>

<div class="user-modal" id="createPatientModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="createPatientTitle">
    <div class="user-modal-backdrop" data-close-patient-modal></div>
    <section class="user-modal-card">
        <div class="user-modal-header">
            <div>
                <h2 id="createPatientTitle">Add New Patient</h2>
                <p>Enter patient details to register a new patient.</p>
            </div>
            <button type="button" class="user-modal-close" data-close-patient-modal aria-label="Close">&times;</button>
        </div>

        @if (TempData["PatientCreateError"] is string createError && !string.IsNullOrWhiteSpace(createError))
        {
            <div class="modal-error">@createError</div>
        }

        <form method="post" asp-controller="Receptionist" asp-action="CreatePatient" class="create-user-form">
            @Html.AntiForgeryToken()
            <div class="modal-section-title">Personal Information</div>

            <label for="createFirstName">Firstname *</label>
            <input id="createFirstName" name="FirstName" required placeholder="Enter first name" />

            <label for="createLastName">Lastname *</label>
            <input id="createLastName" name="LastName" required placeholder="Enter last name" />

            <label for="createMiddleName">Middlename</label>
            <input id="createMiddleName" name="MiddleName" placeholder="Enter middle name (optional)" />

            <label for="createSuffix">Suffix</label>
            <input id="createSuffix" name="Suffix" placeholder="e.g. Jr., Sr., III (optional)" />

            <div class="modal-section-title">Contact & Location</div>

            <label for="createContactNumber">Contact Number *</label>
            <input id="createContactNumber" name="ContactNumber" type="tel" required placeholder="Enter contact number" />

            <label for="createAddress">Address *</label>
            <input id="createAddress" name="Address" required placeholder="Enter complete address" />

            <div class="modal-section-title">Account Information</div>

            <label for="createEmail">Email *</label>
            <input id="createEmail" name="Email" type="email" required placeholder="Enter email address" autocomplete="email" />

            <label for="createPassword">Password *</label>
            <input id="createPassword" name="Password" type="password" minlength="12" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^a-zA-Z0-9]).{12,}" title="Use at least 12 characters with uppercase, lowercase, a number, and a special character." required placeholder="Enter password" autocomplete="new-password" />
            <div class="password-strength" aria-live="polite">
                <div class="password-strength-track"><span id="passwordStrengthBar"></span></div>
                <strong id="passwordStrengthLabel">Enter a password</strong>
            </div>
            <small class="password-requirements">At least 12 characters, including uppercase, lowercase, a number, and a special character.</small>

            <div class="user-modal-actions">
                <button type="button" class="users-clear-button" data-close-patient-modal>Cancel</button>
                <button type="submit" class="users-filter-button">Add Patient</button>
            </div>
        </form>
    </section>
</div>

<div class="user-modal" id="sendReminderModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="sendReminderTitle">
    <div class="user-modal-backdrop" data-close-reminder-modal></div>
    <section class="user-modal-card" style="width: min(100%, 540px);">
        <div class="user-modal-header">
            <div>
                <h2 id="sendReminderTitle" style="display: flex; align-items: center; gap: 8px;">
                    Send Patient Reminder
                </h2>
                <p>Deliver an instant reminder / notice to <strong id="reminderPatientNameDisplay" style="color: #0f172a;"></strong></p>
            </div>
            <button type="button" class="user-modal-close" data-close-reminder-modal aria-label="Close modal">&times;</button>
        </div>

        <form id="sendReminderForm" onsubmit="handleSendReminderSubmit(event)" style="display: flex; flex-direction: column; gap: 14px; margin-top: 16px;">
            @Html.AntiForgeryToken()
            <input type="hidden" id="reminderPatientId" name="patientId" />

            <div>
                <label for="reminderType" style="display: block; font-size: 12px; font-weight: 600; color: #4b5563; margin-bottom: 6px;">Reminder Category / Type *</label>
                <select id="reminderType" name="reminderType" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #dfe3e8; border-radius: 6px; font-size: 13px; color: #0f172a; background: #fff;" required>
                    <option value="Appointment Reminder">Appointment Reminder</option>
                    <option value="Post-Treatment Care">Post-Treatment Care Notice</option>
                    <option value="Payment & Bill Notice">Payment / Billing Notice</option>
                    <option value="Follow-up Checkup">Follow-up Checkup</option>
                    <option value="General Clinic Notice">General Clinic Notice</option>
                </select>
            </div>

            <!-- Quick Template Helpers -->
            <div>
                <label style="display: block; font-size: 11.5px; font-weight: 600; color: #64748b; margin-bottom: 6px;">Quick Templates (Click to fill):</label>
                <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                    <button type="button" class="template-chip" onclick="applyReminderTemplate('appointment')">Appointment Tomorrow</button>
                    <button type="button" class="template-chip" onclick="applyReminderTemplate('care')">Post-Procedure Care</button>
                    <button type="button" class="template-chip" onclick="applyReminderTemplate('payment')">Outstanding Invoice</button>
                    <button type="button" class="template-chip" onclick="applyReminderTemplate('followup')">6-Month Checkup</button>
                </div>
            </div>

            <div>
                <label for="reminderMessage" style="display: block; font-size: 12px; font-weight: 600; color: #4b5563; margin-bottom: 6px;">Reminder Message *</label>
                <textarea id="reminderMessage" name="message" rows="4" style="width: 100%; padding: 10px; border: 1px solid #dfe3e8; border-radius: 6px; font-size: 13px; font-family: inherit; resize: vertical; box-sizing: border-box;" placeholder="Type your reminder message for the patient here..." required></textarea>
            </div>

            <div id="reminderFeedback" style="display: none; padding: 10px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 500;"></div>

            <div class="user-modal-actions" style="margin-top: 10px; padding-top: 14px;">
                <button type="button" class="users-clear-button" data-close-reminder-modal>Cancel</button>
                <button type="submit" id="btnSubmitReminder" class="users-filter-button">
                    Send Reminder
                </button>
            </div>
        </form>
    </section>
</div>

<script src="~/js/register_patients.js" asp-append-version="true"></script>
<script>
    var reminderModal = document.getElementById('sendReminderModal');
    var reminderPatientIdInput = document.getElementById('reminderPatientId');
    var reminderPatientNameDisplay = document.getElementById('reminderPatientNameDisplay');
    var reminderTypeSelect = document.getElementById('reminderType');
    var reminderMessageTextarea = document.getElementById('reminderMessage');
    var reminderFeedback = document.getElementById('reminderFeedback');
    var btnSubmitReminder = document.getElementById('btnSubmitReminder');

    function openSendReminderModal(patientId, patientName) {
        if (!reminderModal) return;
        reminderPatientIdInput.value = patientId;
        reminderPatientNameDisplay.textContent = patientName;
        reminderFeedback.style.display = 'none';
        btnSubmitReminder.disabled = false;
        btnSubmitReminder.textContent = 'Send Reminder';

        // Set default template
        applyReminderTemplate('appointment');

        reminderModal.classList.add('is-open');
        reminderModal.setAttribute('aria-hidden', 'false');
        setTimeout(function() {
            reminderMessageTextarea.focus();
        }, 100);
    }

    function closeSendReminderModal() {
        if (!reminderModal) return;
        reminderModal.classList.remove('is-open');
        reminderModal.setAttribute('aria-hidden', 'true');
    }

    function applyReminderTemplate(type) {
        var patientName = reminderPatientNameDisplay.textContent || 'Patient';
        if (type === 'appointment') {
            reminderTypeSelect.value = 'Appointment Reminder';
            reminderMessageTextarea.value = 'Dear ' + patientName + ', this is a friendly reminder of your upcoming dental appointment at DentalSync Clinic. Please arrive 10 minutes prior to your scheduled time.';
        } else if (type === 'care') {
            reminderTypeSelect.value = 'Post-Treatment Care';
            reminderMessageTextarea.value = 'Dear ' + patientName + ', please follow your post-treatment care instructions: avoid eating hard or hot foods for the next few hours, and take prescribed medications as advised.';
        } else if (type === 'payment') {
            reminderTypeSelect.value = 'Payment & Bill Notice';
            reminderMessageTextarea.value = 'Dear ' + patientName + ', this is a gentle reminder regarding your pending balance/invoice with DentalSync Clinic. You may review your bill in the Patient Portal.';
        } else if (type === 'followup') {
            reminderTypeSelect.value = 'Follow-up Checkup';
            reminderMessageTextarea.value = 'Dear ' + patientName + ', it is time for your routine dental checkup and cleaning. Please schedule an appointment through your portal at your convenience.';
        }
    }

    if (reminderModal) {
        reminderModal.querySelectorAll('[data-close-reminder-modal]').forEach(function(el) {
            el.addEventListener('click', closeSendReminderModal);
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && reminderModal.classList.contains('is-open')) {
                closeSendReminderModal();
            }
        });
    }

    function handleSendReminderSubmit(e) {
        e.preventDefault();
        var form = document.getElementById('sendReminderForm');
        var formData = new FormData(form);

        btnSubmitReminder.disabled = true;
        btnSubmitReminder.textContent = 'Sending...';
        reminderFeedback.style.display = 'none';

        fetch('/Receptionist/SendPatientReminder', {
            method: 'POST',
            body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                reminderFeedback.style.display = 'block';
                reminderFeedback.style.background = '#e9f9ee';
                reminderFeedback.style.color = '#158a3e';
                reminderFeedback.style.border = '1px solid #bbf7d0';
                reminderFeedback.textContent = data.message || 'Reminder sent successfully!';

                setTimeout(function() {
                    closeSendReminderModal();
                }, 1200);
            } else {
                btnSubmitReminder.disabled = false;
                btnSubmitReminder.textContent = 'Send Reminder';
                reminderFeedback.style.display = 'block';
                reminderFeedback.style.background = '#fceaea';
                reminderFeedback.style.color = '#c22a2a';
                reminderFeedback.style.border = '1px solid #fca5a5';
                reminderFeedback.textContent = data.message || 'Failed to send reminder.';
            }
        })
        .catch(function(err) {
            btnSubmitReminder.disabled = false;
            btnSubmitReminder.textContent = 'Send Reminder';
            reminderFeedback.style.display = 'block';
            reminderFeedback.style.background = '#fceaea';
            reminderFeedback.style.color = '#c22a2a';
            reminderFeedback.style.border = '1px solid #fca5a5';
            reminderFeedback.textContent = 'An error occurred while sending the reminder.';
        });
    }
</script>

@functions {
    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "P";
        return parts.Length == 1 ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant() : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
